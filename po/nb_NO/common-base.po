msgstr "Mottakere"

#: templates/CRM/Contact/Form/Task/Email.tpl
msgid "Add CC"
msgstr "Legg til kopi (CC)"

#: templates/CRM/Contact/Form/Task/Email.tpl
msgid "Add BCC"
msgstr "Legg til blindkopi (BCC)"

#: templates/CRM/Contact/Form/Task/Email.tpl
msgid "Email will NOT be sent to %count contact."
msgid_plural "Email will NOT be sent to %count contacts."
msgstr[0] "E-post vil IKKE bli sendt til %count kontakt."
