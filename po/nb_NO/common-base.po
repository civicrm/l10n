msgstr "Rediger prisvalg"

#: templates/CRM/Price/Page/Field.tpl
msgid "Add Price Field"
msgstr "Legg til prisfelt"

#: templates/CRM/Price/Page/Field.tpl
msgid "Preview (all fields)"
msgstr "Forhåndsvis (alle felt)"

