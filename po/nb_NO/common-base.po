msgid "Date:"
msgstr "Dato:"

#: templates/CRM/Note/Form/Note.tpl
msgid "Modified Date:"
msgstr "Endret dato:"

#: templates/CRM/Note/Form/Note.tpl
msgid "Privacy:"
msgstr "Personvern:"

