#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Report Template"
msgstr "Rapportmal"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Constituent Report (Summary)"
msgstr "Kontaktrapport (oppsummering)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a list of address and telephone information for constituent records"
" in your system."
msgstr "Gir en liste av adresser og telefoninformasjon for kontaktoppføringer i systemet ditt."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Constituent Report (Detail)"
msgstr "Kontaktrapport (detalj)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides contact-related information on contributions, memberships, events "
"and activities."
msgstr "Gir kontaktrelatert informasjon om gaver, medlemskap, arrangementer og aktiviteter."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Activity Details Report"
msgstr "Detaljrapport for aktiviteter"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a list of constituent activity including activity statistics for "
"one/all contacts during a given date range(required)"
msgstr "Gir en liste over kontaktaktivitet inkludert aktivitetsstatistikk for en/alle kontakter i løpet av en gitt datoperiode (påkrevd)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Walk / Phone List Report"
msgstr "Gå- / ringe-liste rapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a detailed report for your walk/phonelist for targeted contacts"
msgstr "Gir en detaljert gå-/ringelisterapport for utvalgte kontakter"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Current Employer Report"
msgstr "Nåværende arbeidsgiver rapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides detail list of employer employee relationships along with "
"employment details Ex Join Date"
msgstr "Gir detaljert liste over arbeidsgiver-ansatt-relasjoner sammen med ansettelsesdetaljer, f.eks. påmeldingsdato"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Contribution Summary Report"
msgstr "Oppsummeringsrapport for gaver"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Groups and totals contributions by criteria including contact, time period, "
"financial type, contributor location, etc."
msgstr "Grupperer og summerer gave etter kriterier som kontakt, tidsperiode, regnskapstype, giverlokasjon osv."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Contribution Detail Report"
msgstr "Detaljrapport for gaver"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Lists specific contributions by criteria including contact, time period, "
"financial type, contributor location, etc. Contribution summary report "
"points to this report for contribution details."
msgstr "Lister opp spesifikke gave etter kriterier som kontakt, tidsperiode, regnskapstype, giverlokasjon osv. gaveoppsummeringsrapporten viser til denne rapporten for gavedetaljer."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Repeat Contributions Report"
msgstr "Rapport for gjentagende gaver"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Given two date ranges, shows contacts who contributed in both the date "
"ranges with the amount contributed in each and the percentage increase / "
"decrease."
msgstr "Viser kontakter som ga i begge av to datoperioder, med beløpet som ble gitt i hver periode og prosentvis økning eller nedgang."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Contributions by Organization Report"
msgstr "Rapport over gaver etter organisasjon"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Displays a detailed list of contributions grouped by organization, which "
"includes contributions made by employees for the organisation."
msgstr "Viser en detaljert liste over gaver gruppert etter organisasjon, som inkluderer gaver gitt av ansatte i organisasjonen."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Contributions by Household Report"
msgstr "Rapport over gaver etter husholdning"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Displays a detailed list of contributions grouped by household which "
"includes contributions made by members of the household."
msgstr "Viser en detaljert liste over gaver gruppert etter husholdning, som inkluderer gaver gitt av medlemmer av husholdningen."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Top Donors Report"
msgstr "Rapport over de største giverne"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a list of the top donors during a time period you define. You can "
"include as many donors as you want (for example, top 100 of your donors)."
msgstr "Gir en liste over de største giverne i en valgt periode. Du kan ta med så mange givere du ønsker, for eksempel de 100 største."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "SYBUNT Report"
msgstr "'Noen år, men ikke dette året' - Rapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"SYBUNT means some year(s) but not this year. Provides a list of constituents"
" who donated at some time in the history of your organization but did not "
"donate during the time period you specify."
msgstr "(SYBUNT) Noen år, men ikke dette året. Gir en liste over kontakter som gav en gang i din organisasjons historie, men som ikke gav i løpet av den perioden du angir."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "LYBUNT Report"
msgstr "Sist år, men ikke dette året - rapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"LYBUNT means last year but not this year. Provides a list of constituents "
"who donated last year but did not donate during the time period you specify "
"as the current year."
msgstr "(LYBUNT) Sist år, men ikke dette året. Gir en liste over kontakter som gav sist år, men som ikke gav i løpet av den perioden du angir som det nåværende året."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Soft Credit Report"
msgstr "gavekrediteringrapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Shows contributions made by contacts that have been soft-credited to other "
"contacts."
msgstr "Viser gave gjort av kontakter som har blitt mykt kreditert til andre kontakter."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Membership Report (Summary)"
msgstr "Medlemskapsrapport (oppsummering)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Provides a summary of memberships by type and Member Since."
msgstr "Gir et sammendrag av medlemskap etter type og medlem siden."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Membership Report (Detail)"
msgstr "Medlemskapsrapport (detalj)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a list of members along with their membership status and membership"
" details (Member Since, Membership Start Date, Membership Expiration Date). "
"Can also display contributions (payments) associated with each membership."
msgstr "Gir en liste over medlemmer sammen med deres medlemsstatus og medlemsdetaljer (Member Since, Medlemskapsstartdato, Medlemskapsutløpsdato). Kan også vise gave (betalinger) knyttet til hvert medlemskap."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Membership Report (Lapsed)"
msgstr "Medlemskapsrapport (frafalt)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a list of memberships that lapsed or will lapse before the date you"
" specify."
msgstr "Gir en liste over medlemskap som frafalt, eller som vil frafalle før den datoen du angir."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Event Participant Report (List)"
msgstr "Rapport over arrangementsdeltakere (liste)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Provides lists of participants for an event."
msgstr "Gir en liste over deltakere for et arrangement."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Event Income Report (Summary)"
msgstr "Inntektsrapport for arrangement (oppsummering)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides an overview of event income. You can include key information such "
"as event ID, registration, attendance, and income generated to help you "
"determine the success of an event."
msgstr "Gir en oversik over arrangementsinntekt. Du kan ta med nøkkelinformasjon som arrangements-ID, registrering, deltakelse, og inntekter generert, for å hjelpe deg til å vurdere suksessen av arrangementet."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Event Income Report (Detail)"
msgstr "Inntektsrapport for arrangement (detalj)"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Helps you to analyze the income generated by an event. The report can "
"include details by participant type, status and payment method."
msgstr "Hjelper deg å analysere inntekten generert fra et arrangement. Rapporten kan inneholde detaljer som deltakertyper, status og betalingsmåte."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Pledge Detail Report"
msgstr "Detaljrapport for lovnader"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"List of pledges including amount pledged, pledge status, next payment date, "
"balance due, total amount paid etc."
msgstr "Liste over lovnader med lovet beløp, status, neste betalingsdato, utestående saldo, totalt innbetalt beløp og lignende."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Pledged but not Paid Report"
msgstr "Lovet men ikke betalt - rapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Relationship Report"
msgstr "Relasjonsrapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Case Summary Report"
msgstr "Sak oppsummeringsrapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Provides a summary of cases and their duration by date range, status, staff "
"member and / or case role."
msgstr "Gir en oppsummering av saker og deres varighet etter datointervall, status, stabsmedlem og / eller saksrolle."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Case Time Spent Report"
msgstr "Sak tid brukt rapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Aggregates time spent on case and / or non-case activities by activity type "
"and contact."
msgstr "Summerer tidsbruk på saksaktiviteter og andre aktiviteter etter aktivitetstype og kontakt."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Contact Demographics Report"
msgstr "Rapport over demografien for kontakter"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Demographic breakdown for case clients (and or non-case contacts) in your "
"database. Includes custom contact fields."
msgstr "Demografisk nedbryting av saksklienter (og / eller ikke-saks-kontakter) i databasen din. Inkluderer egendefinerte kontaktfelter."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Database Log Report"
msgstr "Rapport over databaselogg"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid ""
"Log of contact and activity records created or updated in a given date "
"range."
msgstr "Logg over kontakt- og aktivitetsoppføringer som ble opprettet eller oppdatert i et bestemt datointervall."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Activity Summary Report"
msgstr "Sammendragsrapport for aktiviteter"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Shows activity statistics by type / date"
msgstr "Viser aktivitetsstatistikk etter type / dato"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Bookkeeping Transactions Report"
msgstr "Rapport over bokføringstransaksjoner"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Shows Bookkeeping Transactions Report"
msgstr "Vis rapport over bokføringstransaksjoner"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Participant list Count Report"
msgstr "Rapport over antall deltakere"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Shows the Participant list with Participant Count."
msgstr "Viser deltakerliste med deltakerantall."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Income Count Summary Report"
msgstr "Oppsummeringsrapport over inntektsantall."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Shows the Income Summary of events with Count."
msgstr "Viser inntektsoppsummeringen av arrangementer med antall."

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Case Detail Report"
msgstr "Saksdetaljrapport"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
msgid "Case Details"
msgstr "Saksdetaljer"

#: sql/civicrm_data/civicrm_option_group/report_template.sqldata.php
