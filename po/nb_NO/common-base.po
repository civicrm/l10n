msgstr "Taggsett"

#: templates/CRM/Tag/Form/Tag.tpl templates/CRM/Tag/Page/Tag.tpl
msgid "Filter List"
msgstr "Filterliste"

#: templates/CRM/Tag/Page/Tag.tpl
msgid "Tags are a convenient way to categorize data (%1)."
msgstr "Tagger er en praktisk måte å kategorisere data på (%1)."

#: templates/CRM/Tag/Page/Tag.tpl
msgid ""
"Create predefined tags in the main tree, or click the <strong>+</strong> to "
"add a set for free tagging."
msgstr "Opprett forhåndsdefinerte tagger i hovedtreet, eller klikk på <strong>+</strong> for å legge til et sett for fri tagging."

#: templates/CRM/Tag/Page/Tag.tpl
msgid "Main Tag List"
msgstr "Hovedliste over tagger"

#: templates/CRM/Tag/Page/Tag.tpl
