msgstr "Endret til <a href='%1'>%2</a> utført av <a href='%3'>%4</a> %5:"

#: templates/CRM/Logging/ReportDetail.tpl
msgid ""
"This report can not be displayed because there are no relevant entries in "
"the logging tables."
msgstr "Denne rapporten kan ikke vises fordi det ikke finnes relevante oppføringer i loggtabellene."

#: templates/CRM/Logging/ReportDetail.tpl
msgid "Back to Logging Summary"
msgstr "Tilbake til loggsammendraget"

#: templates/CRM/Logging/ReportDetail.tpl
