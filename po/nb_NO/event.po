#: CRM/Event/Form/Registration.php
msgid "Event Fee(s)"
msgstr "Arrangementspris(er)"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Pay Later Label"
msgstr "Etikett for 'betal senere'"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter a valid money value for this field (e.g. %1)."
msgstr "Angi et gyldig beløp i dette feltet (f.eks. %1)."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Discounts by Signup Date?"
msgstr "Rabatter etter påmeldingsdato?"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Discount Name"
msgstr "Rabattnavn"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Add Discount Set to Fee Table"
msgstr "Legg til rabattsett i pristabellen"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "The discount end date cannot be prior to the start date."
msgstr "Sluttdatoen for rabatten kan ikke være før startdatoen."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please specify either start date or end date."
msgstr "Angi enten start- eller sluttdato."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Select non-overlapping discount start date."
msgstr "Velg en startdato for rabatten som ikke overlapper en annen rabatt."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Select either of the dates."
msgstr "Velg én av datoene."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "%1 is already used for Discount Name."
msgstr "%1 er allerede brukt som rabattnavn."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid ""
"At least one fee should be entered for your Discount Set. If you do not see "
"the table to enter discount fees, click the \"Add Discount Set to Fee "
"Table\" button."
msgstr "Det må angis minst én pris i rabattsettet. Hvis tabellen for rabattpriser ikke vises, klikker du på knappen 'Legg til rabattsett i pristabellen'."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please select financial type."
msgstr "Velg regnskapstype."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter the fee label for the paid event."
msgstr "Angi prisetiketten for det betalte arrangementet."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please select an appropriate option as default."
msgstr "Velg et passende alternativ som standard."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter a label for at least one fee level."
msgstr "Angi en etikett for minst ett prisnivå."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter an amount for at least one fee level."
msgstr "Angi et beløp for minst ett prisnivå."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid ""
"Please enter the Pay Later prompt to be displayed on the Registration form."
msgstr "Angi teksten for 'betal senere' som skal vises i påmeldingsskjemaet."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter the Pay Later instructions to be displayed to your users."
msgstr "Angi instruksjonene for 'betal senere' som skal vises for brukerne."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid ""
"You have indicated that this is a paid event, but no payment option has been"
" selected. If this is not a paid event, please select the \"No\" option at "
"the top of the page. If this is a paid event, please select at least one "
"payment processor and/or enable the pay later option."
msgstr "Du har angitt at dette er et betalt arrangement, men ingen betalingsalternativer er valgt. Hvis arrangementet ikke er betalt, velger du 'Nei' øverst på siden. Hvis det er betalt, velger du minst én betalingsleverandør og/eller aktiverer alternativet 'betal senere'."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Event Fees"
msgstr "Arrangementspriser"

