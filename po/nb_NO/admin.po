msgstr "Det er ingen jobber konfigurert."

#: templates/CRM/Admin/Page/JobLog.tpl
msgid ""
"This screen presents the list of most recent 1,000 scheduled jobs log "
"entries."
msgstr "Dette skjermbildet viser de 1 000 nyeste loggoppføringene for planlagte jobber."

#: templates/CRM/Admin/Page/JobLog.tpl
msgid "List of log entries for:"
msgstr "Liste over loggposter for:"

#: templates/CRM/Admin/Page/JobLog.tpl
