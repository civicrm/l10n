#: CRM/Core/Permission.php
msgid "CiviCRM"
msgstr "CiviCRM"

#: CRM/Core/Permission.php
msgid "add contacts"
msgstr "dodaj stike"

#: CRM/Core/Permission.php
msgid "Create a new contact record in CiviCRM"
msgstr "Ustvari nov zapis stika v CiviCRM"

#: CRM/Core/Permission.php
msgid "view all contacts"
msgstr "poglej vse stike"

#: CRM/Core/Permission.php
msgid ""
"View ANY CONTACT in the CiviCRM database, export contact info and perform "
"activities such as Send Email, Phone Call, etc."
msgstr "Ogled KATEREGA KOLI STIKA v podatkovni zbirki CiviCRM, izvoz podatkov o stikih in izvajanje dejavnosti, kot so pošiljanje e-pošte, telefonski klici itd."

#: CRM/Core/Permission.php
msgid "edit all contacts"
msgstr "uredi vse stike"

#: CRM/Core/Permission.php
msgid ""
"View, Edit and Delete ANY CONTACT in the CiviCRM database; Create and edit "
"relationships, tags and other info about the contacts"
msgstr "Ogled, urejanje in brisanje KATEREGA KOLI STIKA v podatkovni zbirki CiviCRM; ustvarjanje in urejanje razmerij, oznak in drugih podatkov o stikih"

#: CRM/Core/Permission.php
msgid "view my contact"
msgstr "poglej svoj stik"

#: CRM/Core/Permission.php
msgid "edit my contact"
msgstr "uredi svoj stik"

#: CRM/Core/Permission.php
msgid "delete contacts"
msgstr "izbriši stike"

#: CRM/Core/Permission.php
msgid "access deleted contacts"
msgstr "dostopaj do izbrisanih stikov"

#: CRM/Core/Permission.php
msgid "Access contacts in the trash"
msgstr "Dostop do stikov v košu"

#: CRM/Core/Permission.php
msgid "import contacts"
msgstr "uvozi stike"

#: CRM/Core/Permission.php
msgid "Import contacts and activities"
msgstr "Uvozi stike in dejavnosti"

#: CRM/Core/Permission.php
msgid "import SQL datasource"
msgstr "uvozi iz vira podatkov SQL"

#: CRM/Core/Permission.php
msgid "When importing, consume data directly from a SQL datasource"
msgstr "Pri uvozu uporabi podatke neposredno iz vira podatkov SQL"

#: CRM/Core/Permission.php
msgid "edit groups"
msgstr "uredi skupine"

#: CRM/Core/Permission.php
msgid ""
"Create new groups, edit group settings (e.g. group name, visibility...), "
"delete groups"
msgstr "Ustvarjanje novih skupin, urejanje nastavitev skupin (npr. imena skupine, vidnosti ...) in brisanje skupin"

#: CRM/Core/Permission.php
msgid "administer CiviCRM"
msgstr "administriraj CiviCRM"

#: CRM/Core/Permission.php
msgid ""
"Perform all tasks in the Administer CiviCRM control panel and Import "
"Contacts"
msgstr "Izvajanje vseh opravil na nadzorni plošči za upravljanje CiviCRM in uvoz stikov"

#: CRM/Core/Permission.php
msgid "skip IDS check"
msgstr "preskoči preverjanje IDS"

#: CRM/Core/Permission.php
msgid ""
"Warning: Give to trusted roles only; this permission has security "
"implications. IDS system is bypassed for users with this permission. "
"Prevents false errors for admin users."
msgstr "Opozorilo: Dodelite samo zaupanja vrednim vlogam; to dovoljenje vpliva na varnost. Za uporabnike s tem dovoljenjem se sistem za zaznavanje vdorov (IDS) obide. S tem se preprečijo lažna opozorila za skrbniške uporabnike."

#: CRM/Core/Permission.php
msgid "access uploaded files"
msgstr "pojdi do naloženih datotek"

#: CRM/Core/Permission.php
msgid "View / download files including images and photos"
msgstr "Ogled in prenos datotek, vključno s slikami in fotografijami"

#: CRM/Core/Permission.php
msgid "profile listings and forms"
msgstr "seznami in obrazci profilov"

#: CRM/Core/Permission.php
msgid ""
"Warning: Give to trusted roles only; this permission has privacy "
"implications. Add/edit data in online forms and access public searchable "
"directories."
msgstr "Opozorilo: Dodelite samo zaupanja vrednim vlogam; to dovoljenje vpliva na zasebnost. Omogoča dodajanje in urejanje podatkov v spletnih obrazcih ter dostop do javnih imenikov z možnostjo iskanja."

#: CRM/Core/Permission.php
msgid "profile listings"
msgstr "seznami profilov"

#: CRM/Core/Permission.php
msgid ""
"Warning: Give to trusted roles only; this permission has privacy "
"implications. Access public searchable directories."
msgstr "Opozorilo: Dodelite samo zaupanja vrednim vlogam; to dovoljenje vpliva na zasebnost. Omogoča dostop do javnih imenikov z možnostjo iskanja."

#: CRM/Core/Permission.php
msgid "profile create"
msgstr "ustvari profil"

#: CRM/Core/Permission.php
msgid "Add data in a profile form."
msgstr "Dodajanje podatkov v obrazec profila."

#: CRM/Core/Permission.php
msgid "profile edit"
msgstr "uredi profil"

#: CRM/Core/Permission.php
msgid "Edit data in a profile form."
msgstr "Urejanje podatkov v obrazcu profila."

#: CRM/Core/Permission.php
msgid "profile view"
msgstr "poglej profil"

#: CRM/Core/Permission.php
msgid "View data in a profile."
msgstr "Ogled podatkov v profilu."

#: CRM/Core/Permission.php
msgid "access all custom data"
msgstr "pojdi do vseh posebnih podatkov"

#: CRM/Core/Permission.php
msgid "View all custom fields regardless of ACL rules"
msgstr "Ogled vseh polj po meri ne glede na pravila nadzora dostopa (ACL)"

#: CRM/Core/Permission.php
msgid "view all activities"
msgstr "poglej vse dejavnosti"

#: CRM/Core/Permission.php
msgid "View all activities (for visible contacts)"
msgstr "Ogled vseh dejavnosti (za vidne stike)"

#: CRM/Core/Permission.php
msgid "Delete activities"
msgstr "Izbriši dejavnosti"

#: CRM/Core/Permission.php
msgid "edit inbound email basic information"
msgstr "uredi osnovne podatke dohodne e-pošte"

#: CRM/Core/Permission.php
msgid ""
"Edit all inbound email activities (for visible contacts) basic information. "
"Content editing not allowed."
msgstr "Urejanje osnovnih podatkov vseh dejavnosti dohodne e-pošte (za vidne stike). Urejanje vsebine ni dovoljeno."

#: CRM/Core/Permission.php
msgid "edit inbound email basic information and content"
msgstr "uredi osnovne podatke in vsebino dohodne e-pošte"

#: CRM/Core/Permission.php
msgid ""
"Edit all inbound email activities (for visible contacts) basic information "
"and content."
msgstr "Urejanje osnovnih podatkov in vsebine vseh dejavnosti dohodne e-pošte (za vidne stike)."

#: CRM/Core/Permission.php
msgid "access CiviCRM backend and API"
msgstr "dostopaj do skrbniškega vmesnika in API-ja CiviCRM"

#: CRM/Core/Permission.php
msgid ""
"Master control for access to the main CiviCRM backend and API. Give to "
"trusted roles only."
msgstr "Glavno dovoljenje za dostop do skrbniškega vmesnika in API-ja CiviCRM. Dodelite samo zaupanja vrednim vlogam."

#: CRM/Core/Permission.php
msgid "access Contact Dashboard"
msgstr "pojdi na Ploščo stikov"

#: CRM/Core/Permission.php
msgid "View Contact Dashboard (for themselves and visible contacts)"
msgstr "Ogled nadzorne plošče stika (za svoj stik in vidne stike)"

#: CRM/Core/Permission.php
msgid "translate CiviCRM"
msgstr "prevedi CiviCRM"

#: CRM/Core/Permission.php
msgid "Allow User to enable multilingual"
msgstr "Uporabniku dovoli omogočanje večjezičnosti"

#: CRM/Core/Permission.php
msgid "manage tags"
msgstr "upravljaj oznake"

#: CRM/Core/Permission.php
msgid "Create and rename tags"
msgstr "Ustvarjanje in preimenovanje oznak"

#: CRM/Core/Permission.php
msgid "administer reserved groups"
msgstr "upravljaj rezervirane skupine"

#: CRM/Core/Permission.php
msgid "Edit and disable Reserved Groups (Needs Edit Groups)"
msgstr "Urejanje in onemogočanje rezerviranih skupin (zahteva dovoljenje za urejanje skupin)"

#: CRM/Core/Permission.php
msgid "administer Tagsets"
msgstr "upravljaj nabore oznak"

#: CRM/Core/Permission.php
msgid "administer reserved tags"
msgstr "upravljaj rezervirane oznake"

#: CRM/Core/Permission.php
msgid "administer queues"
msgstr "upravljaj čakalne vrste"

#: CRM/Core/Permission.php
msgid "Initialize, browse, and cancel background processing queues"
msgstr "Inicializacija, pregledovanje in preklic čakalnih vrst za obdelavo v ozadju"

#: CRM/Core/Permission.php
msgid "administer dedupe rules"
msgstr "upravljaj pravila za odpravljanje dvojnikov"

#: CRM/Core/Permission.php
msgid "Create and edit rules, change the supervised and unsupervised rules"
msgstr "Ustvarjanje in urejanje pravil ter spreminjanje pravil za nadzorovano in nenadzorovano odpravljanje dvojnikov"

#: CRM/Core/Permission.php
msgid "merge duplicate contacts"
msgstr "združi podvojene stike"

#: CRM/Core/Permission.php
msgid "Delete Contacts must also be granted in order for this to work."
msgstr "Za delovanje mora biti dodeljeno tudi dovoljenje za brisanje stikov."

#: CRM/Core/Permission.php
msgid "force merge duplicate contacts"
msgstr "prisilno združi podvojene stike"

#: CRM/Core/Permission.php
msgid "view debug output"
msgstr "poglej izpis za razhroščevanje"

#: CRM/Core/Permission.php
msgid "View results of debug and backtrace"
msgstr "Ogled rezultatov razhroščevanja in sledi klicev"

#: CRM/Core/Permission.php
msgid "view all notes"
msgstr "poglej vse opombe"

#: CRM/Core/Permission.php
msgid "View notes (for visible contacts) even if they're marked admin only"
msgstr "Ogled opomb (za vidne stike), tudi če so označene kot dostopne samo skrbnikom"

#: CRM/Core/Permission.php
msgid "add contact notes"
msgstr "dodaj opombe stikom"

#: CRM/Core/Permission.php
msgid "Create notes for contacts"
msgstr "Ustvarjanje opomb za stike"

#: CRM/Core/Permission.php
msgid "access AJAX API"
msgstr "dostopaj do API-ja AJAX"

#: CRM/Core/Permission.php
msgid "Allow API access even if Access CiviCRM is not granted"
msgstr "Dovoli dostop do API-ja tudi brez dovoljenja za dostop do CiviCRM"

#: CRM/Core/Permission.php
msgid "access contact reference fields"
msgstr "dostopaj do polj s sklici na stike"

#: CRM/Core/Permission.php
msgid "Allow entering data into contact reference fields"
msgstr "Dovoli vnos podatkov v polja s sklici na stike"

#: CRM/Core/Permission.php
msgid "create manual batch"
msgstr "ustvari ročni paket"

#: CRM/Core/Permission.php
msgid ""
"Create an accounting batch (with Access to CiviContribute and View Own/All "
"Manual Batches)"
msgstr "Ustvarjanje računovodskega paketa (z dovoljenjema za dostop do CiviContribute in ogled lastnih ali vseh ročnih paketov)"

#: CRM/Core/Permission.php
msgid "edit own manual batches"
msgstr "uredi lastne ročne pakete"

#: CRM/Core/Permission.php
msgid "Edit accounting batches created by user"
msgstr "Urejanje računovodskih paketov, ki jih je ustvaril uporabnik"

#: CRM/Core/Permission.php
msgid "edit all manual batches"
msgstr "uredi vse ročne pakete"

#: CRM/Core/Permission.php
msgid "Edit all accounting batches"
msgstr "Urejanje vseh računovodskih paketov"

#: CRM/Core/Permission.php
msgid "close own manual batches"
msgstr "zapri lastne ročne pakete"

#: CRM/Core/Permission.php
msgid ""
"Close accounting batches created by user (with Access to CiviContribute)"
msgstr "Zapiranje računovodskih paketov, ki jih je ustvaril uporabnik (z dovoljenjem za dostop do CiviContribute)"

#: CRM/Core/Permission.php
msgid "close all manual batches"
msgstr "zapri vse ročne pakete"

#: CRM/Core/Permission.php
msgid "Close all accounting batches (with Access to CiviContribute)"
msgstr "Zapiranje vseh računovodskih paketov (z dovoljenjem za dostop do CiviContribute)"

#: CRM/Core/Permission.php
msgid "reopen own manual batches"
msgstr "znova odpri lastne ročne pakete"

#: CRM/Core/Permission.php
msgid ""
"Reopen accounting batches created by user (with Access to CiviContribute)"
msgstr "Ponovno odpiranje računovodskih paketov, ki jih je ustvaril uporabnik (z dovoljenjem za dostop do CiviContribute)"

#: CRM/Core/Permission.php
msgid "reopen all manual batches"
msgstr "znova odpri vse ročne pakete"

#: CRM/Core/Permission.php
msgid "Reopen all accounting batches (with Access to CiviContribute)"
msgstr "Ponovno odpiranje vseh računovodskih paketov (z dovoljenjem za dostop do CiviContribute)"

#: CRM/Core/Permission.php
msgid "view own manual batches"
msgstr "poglej lastne ročne pakete"

#: CRM/Core/Permission.php
msgid ""
"View accounting batches created by user (with Access to CiviContribute)"
msgstr "Ogled računovodskih paketov, ki jih je ustvaril uporabnik (z dovoljenjem za dostop do CiviContribute)"

#: CRM/Core/Permission.php
msgid "view all manual batches"
msgstr "poglej vse ročne pakete"

#: CRM/Core/Permission.php
msgid "View all accounting batches (with Access to CiviContribute)"
msgstr "Ogled vseh računovodskih paketov (z dovoljenjem za dostop do CiviContribute)"

#: CRM/Core/Permission.php
msgid "delete own manual batches"
msgstr "izbriši lastne ročne pakete"

#: CRM/Core/Permission.php
msgid "Delete accounting batches created by user"
msgstr "Brisanje računovodskih paketov, ki jih je ustvaril uporabnik"

#: CRM/Core/Permission.php
msgid "delete all manual batches"
msgstr "izbriši vse ročne pakete"

#: CRM/Core/Permission.php
msgid "Delete all accounting batches"
msgstr "Brisanje vseh računovodskih paketov"

#: CRM/Core/Permission.php
msgid "export own manual batches"
msgstr "izvozi lastne ročne pakete"

#: CRM/Core/Permission.php
msgid "Export accounting batches created by user"
msgstr "Izvoz računovodskih paketov, ki jih je ustvaril uporabnik"

#: CRM/Core/Permission.php
msgid "export all manual batches"
msgstr "izvozi vse ročne pakete"

#: CRM/Core/Permission.php
msgid "Export all accounting batches"
msgstr "Izvoz vseh računovodskih paketov"

#: CRM/Core/Permission.php
msgid "administer payment processors"
msgstr "upravljaj plačilne procesorje"

#: CRM/Core/Permission.php
msgid "Add, Update, or Disable Payment Processors"
msgstr "Dodajanje, posodabljanje ali onemogočanje plačilnih procesorjev"

#: CRM/Core/Permission.php
msgid "render templates"
msgstr "izriši predloge"

#: CRM/Core/Permission.php
msgid ""
"Render open-ended template content. (Additional constraints may apply to "
"autoloaded records and specific notations.)"
msgstr "Izris poljubne vsebine predlog. (Za samodejno naložene zapise in določene oblike zapisa lahko veljajo dodatne omejitve.)"

#: CRM/Core/Permission.php
msgid "edit message templates"
msgstr "uredi predloge sporočil"

#: CRM/Core/Permission.php
msgid "edit system workflow message templates"
msgstr "uredi predloge sporočil sistemskih delovnih tokov"

#: CRM/Core/Permission.php
msgid "edit user-driven message templates"
msgstr "uredi predloge uporabniških sporočil"

#: CRM/Core/Permission.php
msgid "view my invoices"
msgstr "poglej svoje račune"

#: CRM/Core/Permission.php
msgid "Allow users to view/ download their own invoices"
msgstr "Uporabnikom dovoli ogled in prenos lastnih računov"

#: CRM/Core/Permission.php
msgid "edit api keys"
msgstr "uredi ključe API-ja"

#: CRM/Core/Permission.php
msgid "Edit API keys"
msgstr "Urejanje ključev API-ja"

#: CRM/Core/Permission.php
msgid "edit own api keys"
msgstr "uredi lastne ključe API-ja"

#: CRM/Core/Permission.php
msgid "Edit user's own API keys"
msgstr "Urejanje uporabnikovih lastnih ključev API-ja"

#: CRM/Core/Permission.php
msgid "send SMS"
msgstr "pošlji SMS"

#: CRM/Core/Permission.php
msgid "Send an SMS"
msgstr "Pošiljanje sporočila SMS"

#: CRM/Core/Permission.php
msgid "administer CiviCRM System"
msgstr "upravljaj sistem CiviCRM"

#: CRM/Core/Permission.php
msgid "Perform all system administration tasks in CiviCRM"
msgstr "Izvajanje vseh skrbniških opravil sistema CiviCRM"

#: CRM/Core/Permission.php
msgid "administer CiviCRM Data"
msgstr "upravljaj podatke CiviCRM"

#: CRM/Core/Permission.php
msgid "Permit altering all restricted data options"
msgstr "Dovoli spreminjanje vseh podatkovnih možnosti z omejenim dostopom"

#: CRM/Core/Permission.php
msgid "all CiviCRM permissions and ACLs"
msgstr "vsa dovoljenja in pravila nadzora dostopa (ACL) v CiviCRM"

#: CRM/Core/Permission.php
msgid ""
"Administer and use CiviCRM bypassing any other permission or ACL checks and "
"enabling the creation of displays and forms that allow others to bypass "
"checks. This permission should be given out with care"
msgstr "Upravljanje in uporaba CiviCRM z obhodom vseh drugih preverjanj dovoljenj ali pravil nadzora dostopa (ACL) ter omogočanje ustvarjanja prikazov in obrazcev, ki tudi drugim omogočajo obhod preverjanj. To dovoljenje je treba dodeljevati previdno"

#: CRM/Core/Permission.php
msgid "administer Multiple Organizations"
msgstr "upravljaj več organizacij"

#: CRM/Core/Permission.php
msgid ""
"Administer multiple organizations. In practice this allows editing the group"
" organization link"
msgstr "Upravljanje več organizacij. V praksi to omogoča urejanje povezave med skupino in organizacijo"
