#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Constituent Summary"
msgstr "Povzetek stikov"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides a list of address and telephone information for constituent records"
" in your system."
msgstr "Zagotavlja seznam naslovov in telefonskih informacij za sestavne zapise v vašem sistemu."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Constituent Detail"
msgstr "Podrobnosti stikov"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides contact-related information on contributions, memberships, events "
"and activities."
msgstr "Zagotavlja stikne informacije o prispevkih, članstvih, dogodkih in dejavnostih."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Activity Details"
msgstr "Podrobnosti dejavnosti"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides a list of constituent activity including activity statistics for "
"one/all contacts during a given date range(required)"
msgstr "Zagotavlja seznam sestavnih dejavnosti, vključno s statistiko dejavnosti za enega/vse stike v določenem časovnem obdobju (obvezno)"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Current Employers"
msgstr "Trenutni delodajalci"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides detail list of employer employee relationships along with "
"employment details."
msgstr "Zagotavlja podroben seznam razmerij med delodajalci in zaposlenimi skupaj s podrobnostmi o zaposlitvi."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Gives relationship details between two contacts"
msgstr "Poda podrobnosti o odnosu med dvema stikoma"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Activity Summary"
msgstr "Povzetek dejavnosti"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Shows activity statistics by type / date"
msgstr "Prikazuje statistiko dejavnosti glede na vrsto/datum"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Contribution Summary"
msgstr "Povzetek prispevka"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Groups and totals contributions by criteria including contact, time period, "
"contribution type, contributor location, etc."
msgstr "Združuje in sešteva prispevke po merilih, vključno s stikom, časovnim obdobjem, vrsto prispevka, lokacijo prispevajočega itd."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Contribution Details"
msgstr "Podrobnosti prispevka"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Lists specific contributions by criteria including contact, time period, "
"contribution type, contributor location, etc. Contribution summary report "
"points to this report for contribution details."
msgstr "Navaja določene prispevke po kriterijih, vključno s stikom, časovnim obdobjem, vrsto prispevka, lokacijo prispevajočega itd. Povzetek prispevka kaže na to poročilo za podrobnosti o prispevku."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Repeat Contributions"
msgstr "Ponovljeni prispevki"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Given two date ranges, shows contacts who contributed in both the date "
"ranges with the amount contributed in each and the percentage increase / "
"decrease."
msgstr "Glede na dve časovni obdobji prikazuje stike, ki so prispevali v obeh časovnih obdobjih, z zneskom prispevanja v vsakem in odstotkom povečanja/zmanjšanja."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "SYBUNT (some year but not this year)"
msgstr "SYBUNT (neko leto, letos pa ne)"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Some year(s) but not this year. Provides a list of constituents who donated "
"at some time in the history of your organization but did not donate during "
"the time period you specify."
msgstr "Nekaj ​​let, vendar ne letos. Zagotavlja seznam udeležencev, ki so darovali nekoč v zgodovini vaše organizacije, vendar niso darovali v časovnem obdobju, ki ga določite."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "LYBUNT (last year but not this year)"
msgstr "LYBUNT (lani letos ne)"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Last year but not this year. Provides a list of constituents who donated "
"last year but did not donate during the time period you specify as the "
"current year."
msgstr "Lani, letos pa ne. Zagotavlja seznam udeležencev, ki so darovali lani, vendar niso darovali v časovnem obdobju, ki ga določite kot tekoče leto."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Contributions by Organization"
msgstr "Prispevki organizacije"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Displays a detailed list of contributions grouped by organization, which "
"includes contributions made by employees for the organisation."
msgstr "Prikaže podroben seznam prispevkov, razvrščenih po organizacijah, ki vključuje prispevke zaposlenih za organizacijo."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Contributions by Household"
msgstr "Prispevki gospodinjstev"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Displays a detailed list of contributions grouped by household which "
"includes contributions made by members of the household."
msgstr "Prikaže podroben seznam prispevkov, razvrščenih po gospodinjstvih, ki vključuje prispevke članov gospodinjstva."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Top Donors"
msgstr "Največji donatorji"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides a list of the top donors during a time period you define. You can "
"include as many donors as you want (for example, top 100 of your donors)."
msgstr "Ponuja seznam najboljših donatorjev v časovnem obdobju, ki ga določite. Vključite lahko poljubno število donatorjev (na primer 100 najboljših vaših donatorjev)."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Soft Credits"
msgstr "Mehki krediti"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Shows contributions made by contacts that have been soft-credited to other "
"contacts."
msgstr "Prikazuje prispevke stikov, ki so bili mehko pripisani drugim stikom."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Contribution Aggregate by Relationship"
msgstr "Skupni prispevek po razmerju"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"List contact's donation history, grouped by year, along with contributions "
"attributed to any of the contact's related contacts."
msgstr "Seznam zgodovine donacij stika, razvrščene po letih, skupaj s prispevki, pripisanimi kateremu koli stiku, povezanemu s stikom."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Personal Campaign Page Summary"
msgstr "Povzetek strani osebne kampanje"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Summarizes amount raised and number of contributors for each Personal "
"Campaign Page."
msgstr "Povzema zbrane zneske in število prispevkov za vsako stran osebne kampanje."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Pledge Detail"
msgstr "Podrobnosti o obljubi"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"List of pledges including amount pledged, pledge status, next payment date, "
"balance due, total amount paid etc."
msgstr "Seznam obljub, vključno z obljubljenim zneskom, statusom obljube, datumom naslednjega plačila, zapadlim zneskom, skupnim plačanim zneskom itd."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Pledged But not Paid"
msgstr "Obljubljeno, vendar ne plačano"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Pledged but not Paid Report"
msgstr "Poročilo o obljubljenih, vendar neplačanih zneskih"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Bookkeeping Transactions"
msgstr "Knjigovodske transakcije"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides transaction details for all contributions and payments, including "
"Transaction #, Invoice ID, Payment Instrument and Check #."
msgstr "Zagotavlja podrobnosti transakcije za vse prispevke in plačila, vključno s številko transakcije, ID-jem računa, plačilnim instrumentom in številko čeka."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Provides information about the status of recurring contributions"
msgstr "Zagotavlja informacije o statusu ponavljajočih se prispevkov"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Membership Summary"
msgstr "Povzetek članstva"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Provides a summary of memberships by Type and Member Since."
msgstr "Ponuja povzetek članstev po vrsti in članu od."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Membership Details"
msgstr "Podrobnosti o članstvu"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides a list of members along with their Membership Status and membership"
" details (Member Since, Membership Start Date, Membership Expiration Date). "
"Can also display contributions (payments) associated with each membership."
msgstr "Zagotavlja seznam članov skupaj z njihovim statusom članstva in podrobnostmi o članstvu (član od, začetni datum članstva, datum poteka članstva). Lahko prikaže tudi prispevke (plačila), povezane z vsakim članstvom."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Contribution and Membership Details"
msgstr "Podrobnosti o prispevku in članstvu"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Contribution details for any type of contribution, plus associated "
"membership information for contributions which are in payment for "
"memberships."
msgstr "Podrobnosti o prispevkih za katero koli vrsto prispevkov in povezane informacije o članstvu za prispevke, ki se plačajo za članarine."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Lapsed Memberships"
msgstr "Potekla članstva"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides a list of memberships that have lapsed or will lapse by the date "
"you specify."
msgstr "Ponuja seznam članstev, ki so potekla ali bodo potekla do datuma, ki ga določite."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Provides lists of participants for an event."
msgstr "Zagotavlja sezname udeležencev dogodka."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Event Income Summary"
msgstr "Povzetek prihodkov dogodka"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides an overview of event income. You can include key information such "
"as event ID, registration, attendance, and income generated to help you "
"determine the success of an event."
msgstr "Ponuja pregled prihodkov dogodkov. Vključite lahko ključne informacije, kot so ID dogodka, registracija, udeležba in ustvarjeni dohodek, ki vam pomagajo določiti uspeh dogodka."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Event Income Details"
msgstr "Podrobnosti o dohodku dogodka"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Helps you to analyze the income generated by an event. The report can "
"include details by participant type, status and payment method."
msgstr "Pomaga vam pri analizi dohodka, ustvarjenega z dogodkom. Poročilo lahko vključuje podrobnosti glede na vrsto udeleženca, status in način plačila."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Attendee List"
msgstr "Seznam udeležencev"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Provides lists of event attendees."
msgstr "Ponuja sezname udeležencev dogodka."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Mail Bounces"
msgstr "Zavrnjena pošta"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Bounce Report for mailings"
msgstr "Poročilo o zavrnjenih pošiljkah"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Mailing Summary"
msgstr "Povzetek pošiljanja"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Summary statistics for mailings"
msgstr "Zbirna statistika za pošiljanje"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Mail Opened"
msgstr "Pošta je odprta"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Display contacts who opened emails from a mailing"
msgstr "Prikažite stike, ki so odprli e-poštna sporočila iz poštnega sporočila"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Mail Clickthroughs"
msgstr "Kliki povezav v pošiljanjih"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Display clicks from each mailing"
msgstr "Prikaži klike iz vsake pošte"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Mailing Details"
msgstr "Podrobnosti o pošiljanju"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Provides reporting on Intended and Successful Deliveries, Unsubscribes and "
"Opt-outs, Replies and Forwards."
msgstr "Zagotavlja poročanje o načrtovanih in uspešnih dostavah, odjavah in zavrnitvah, odgovorih in posredovanjih."

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid "Survey Details"
msgstr "Podrobnosti ankete"

#: xml/templates/civicrm_navigation.tpl
msgctxt "menu"
msgid ""
"Detailed report for canvassing, phone-banking, walk lists or other surveys."
msgstr "Podrobno poročilo za anketiranje, telefonsko bančništvo, sezname sprehodov ali druge raziskave."

msgctxt "menu"
msgid "CiviMail Actions"
msgstr "Dejanja CiviMail"

msgctxt "menu"
msgid "Email a Member"
msgstr "Pošlji e-pošto članu"
