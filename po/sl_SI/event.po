msgid "Introductory Text"
msgstr "Uvodno besedilo"

#: CRM/Event/Form/ManageEvent/Registration.php
#: schema/Event/Event.entityType.php
msgid "Footer Text"
msgstr "Besedilo v nogi"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Top Profile Fields for Additional Participants"
msgstr "Polja profila za dodatne udeležence na vrhu"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Bottom Profile Fields for Additional Participants"
msgstr "Polja profila za dodatne udeležence na dnu"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Use a confirmation screen?"
msgstr "Uporabi potrditveni zaslon?"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Send a confirmation email"
msgstr "Pošlji potrditveno e-poštno sporočilo"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "CC Confirmation To"
msgstr "Kopijo potrditve pošlji"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "BCC Confirmation To"
msgstr "Skrito kopijo potrditve pošlji"

#: CRM/Event/Form/ManageEvent/Registration.php
#: schema/Event/Event.entityType.php
msgid "Confirm From Name"
msgstr "Ime pošiljatelja potrditve"

#: CRM/Event/Form/ManageEvent/Registration.php
#: schema/Event/Event.entityType.php
msgid "Confirm From Email"
msgstr "E-poštni naslov pošiljatelja potrditve"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Please enter Registration Link Text"
msgstr "Vnesite besedilo povezave za prijavo"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Please enter a Title for the registration Confirmation Page"
msgstr "Vnesite naslov strani za potrditev prijave"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Please enter a Title for the registration Thank-you Page"
msgstr "Vnesite naslov zahvalne strani za prijavo"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Please enter Confirmation Email FROM Name."
msgstr "Vnesite ime pošiljatelja potrditvenega sporočila."

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Please enter Confirmation Email FROM Email Address."
msgstr "Vnesite e-poštni naslov pošiljatelja potrditvenega sporočila."

#: CRM/Event/Form/ManageEvent/Registration.php
msgid ""
"Please add a profile with an email address if 'Send Confirmation Email?' is "
"selected"
msgstr "Dodaj profil z e-poštnim naslovom, če je izbrano 'Pošiljna e-pošta?'"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid ""
"Allow multiple registrations from the same email address requires a profile "
"of type 'Individual'"
msgstr "Dovoli več prijav z istega e-naslova zahteva profil vrste 'Individual'"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid ""
"Please include a Profile for online registration that contains an Email "
"Address field and / or First Name + Last Name fields."
msgstr "Prosimo, vključite profil za spletno prijavo, ki vsebuje polje Email naslov in / ali ime + Priimek polja."

#: CRM/Event/Form/ManageEvent/Registration.php
msgid ""
"Please include a Profile for online registration of additional participants "
"that contains an Email Address field and / or First Name + Last Name fields."
msgstr "Prosimo, vključite profil za spletno prijavo dodatnih udeležencev, ki vsebuje polje e-poštni naslov in / ali ime + Priimek polja."

#: CRM/Event/Form/ManageEvent/Registration.php
msgid "Profile for Additional Participants"
msgstr "Profil za dodatne udeležence"

#: CRM/Event/Form/ManageEvent/Registration.php
msgid ""
"The selected profiles do not contain the fields necessary to match "
