#: templates/CRM/Event/Page/ManageEvent.hlp
msgid ""
"start=YYYYMMDD - Specify a different starting date range for the events to "
"be listed."
msgstr "start=LLLLMMDD - Navedite drugačen začetni datum za dogodke, ki bodo navedeni."

