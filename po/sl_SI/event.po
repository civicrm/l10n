#: CRM/Event/Form/Registration.php
msgid "Event Fee(s)"
msgstr "Kotizacije"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Pay Later Label"
msgstr "Oznaka poznejšega plačila"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter a valid money value for this field (e.g. %1)."
msgstr "Vnesite veljaven denarni znesek (npr. %1)."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Discounts by Signup Date?"
msgstr "Popusti glede na datum prijave?"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Discount Name"
msgstr "Ime popusta"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Add Discount Set to Fee Table"
msgstr "Dodaj nabor popustov v tabelo kotizacij"

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "The discount end date cannot be prior to the start date."
msgstr "Končni datum popusta ne more biti pred začetnim datumom."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please specify either start date or end date."
msgstr "Navedite začetni ali končni datum."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Select non-overlapping discount start date."
msgstr "Izberite datum začetka brez prekrivnega popusta."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Select either of the dates."
msgstr "Izberite enega od datumov."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "%1 is already used for Discount Name."
msgstr "%1 se že uporablja za Popust Ime."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid ""
"At least one fee should be entered for your Discount Set. If you do not see "
"the table to enter discount fees, click the \"Add Discount Set to Fee "
"Table\" button."
msgstr "Vsaj eno kotizacijo je treba vnesti za vaš popust Set. Če ne vidite tabele za vpis popust kotizacij, kliknite \"Dodaj popust Set za kotizacijo mizo\"."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please select financial type."
msgstr "Izberite finančno vrsto."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter the fee label for the paid event."
msgstr "Vnesite oznako kotizacije za plačljivi dogodek."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please select an appropriate option as default."
msgstr "Izberite ustrezno možnost kot privzeto."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter a label for at least one fee level."
msgstr "Vnesite oznako za vsaj eno višino kotizacije."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter an amount for at least one fee level."
msgstr "Vnesite znesek za vsaj eno višino kotizacije."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid ""
"Please enter the Pay Later prompt to be displayed on the Registration form."
msgstr "Prosimo, vnesite poziv Pay Kasneje, da se prikaže na prijavnici."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Please enter the Pay Later instructions to be displayed to your users."
msgstr "Prosimo, vnesite navodila za plačilo kasneje, ki se prikažejo uporabnikom."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid ""
"You have indicated that this is a paid event, but no payment option has been"
" selected. If this is not a paid event, please select the \"No\" option at "
"the top of the page. If this is a paid event, please select at least one "
"payment processor and/or enable the pay later option."
msgstr "Nakazali ste, da je to plačan dogodek, vendar ni bila izbrana nobena možnost plačila. Če to ni plačan dogodek, izberite možnost » Ne « na vrhu strani. Če je to plačan dogodek, izberite vsaj en procesor plačila in/ali omogočite kasnejšo možnost plačila."

#: CRM/Event/Form/ManageEvent/Fee.php
msgid "Event Fees"
msgstr "Kotizacije dogodka"

