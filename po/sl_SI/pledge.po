#: schema/Pledge/Pledge.entityType.php
msgid ""
"Promises to contribute at a future time, either in full, or at regular "
"intervals until a total goal is reached."
msgstr "Zaveze za prihodnja vplačila prispevkov, bodisi v celoti bodisi v rednih časovnih presledkih, dokler ni dosežen skupni ciljni znesek."

#: schema/Pledge/Pledge.entityType.php
msgid "Foreign key to civicrm_contact.id ."
msgstr "Tuji ključ do civicrm_contact.id."

#: schema/Pledge/Pledge.entityType.php
msgid "FK to Financial Type"
msgstr "Tuji ključ do finančne vrste"

#: schema/Pledge/Pledge.entityType.php
msgid "Contribution Page ID"
msgstr "ID strani za prispevke"

#: schema/Pledge/Pledge.entityType.php
msgid "The Contribution Page which triggered this contribution"
msgstr "Stran za prispevke, prek katere je bil oddan ta prispevek"

#: schema/Pledge/Pledge.entityType.php
msgid "Total pledged amount."
msgstr "Skupni zavezani znesek."

#: schema/Pledge/Pledge.entityType.php
msgid "Original Installment Amount"
msgstr "Prvotni znesek obroka"

#: schema/Pledge/Pledge.entityType.php
msgid "Original amount for each of the installments."
msgstr "Prvotni znesek posameznega obroka."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge Currency"
msgstr "Valuta zaveze"

#: schema/Pledge/Pledge.entityType.php
msgid "Time units for recurrence of pledge payments."
msgstr "Časovne enote ponavljanja plačil zaveze."

#: schema/Pledge/Pledge.entityType.php
msgid "Number of time units for recurrence of pledge payments."
msgstr "Število časovnih enot med ponovitvami plačil zaveze."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge day"
msgstr "Dan plačila zaveze"

#: schema/Pledge/Pledge.entityType.php
msgid ""
"Day in the period when the pledge payment is due e.g. 1st of month, 15th "
"etc. Use this to set the scheduled dates for pledge payments."
msgstr "Dan v obdobju, ko zapade plačilo zaveze, npr. 1. ali 15. dan v mesecu. S tem določite načrtovane datume plačil zaveze."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge Number of Installments"
msgstr "Število obrokov zaveze"

#: schema/Pledge/Pledge.entityType.php
msgid "Total number of payments to be made."
msgstr "Skupno število predvidenih plačil."

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
msgid "The date the first scheduled pledge occurs."
msgstr "Datum prvega načrtovanega plačila zaveze."

#: schema/Pledge/Pledge.entityType.php
msgid "When this pledge record was created."
msgstr "Datum ustvarjanja tega zapisa o zavezi."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge Acknowledged"
msgstr "Zaveza potrjena"

#: schema/Pledge/Pledge.entityType.php
msgid "When a pledge acknowledgement message was sent to the contributor."
msgstr "Datum pošiljanja potrdila o zavezi prispevajočemu."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge Modified Date"
msgstr "Datum spremembe zaveze"

#: schema/Pledge/Pledge.entityType.php
msgid "Last updated date for this pledge record."
msgstr "Datum zadnje posodobitve tega zapisa o zavezi."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge Cancelled Date"
msgstr "Datum preklica zaveze"

#: schema/Pledge/Pledge.entityType.php
msgid "Date this pledge was cancelled by contributor."
msgstr "Datum, ko je prispevajoči preklical to zavezo."

#: schema/Pledge/Pledge.entityType.php
msgid ""
"Date this pledge finished successfully (total pledge payments equal to or "
"greater than pledged amount)."
msgstr "Datum uspešnega zaključka zaveze (vsota plačil zaveze je enaka ali večja od zavezanega zneska)."

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
msgid "Maximum Number of Reminders"
msgstr "Največje število opomnikov"

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
msgid "The maximum number of payment reminders to send for any given payment."
msgstr "Največje število opomnikov za posamezno plačilo."

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
#: templates/CRM/Pledge/Form/PledgeView.tpl
msgid "Initial Reminder Day"
msgstr "Število dni pred zapadlostjo za prvi opomnik"

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
msgid "Send initial reminder this many days prior to the payment due date."
msgstr "Pošlji prvi opomnik toliko dni pred datumom zapadlosti plačila."

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
msgid "Additional Reminder Days"
msgstr "Število dni med dodatnimi opomniki"

#: schema/Pledge/Pledge.entityType.php
#: schema/Pledge/PledgeBlock.entityType.php
msgid ""
"Send additional reminder this many days after last one sent, up to maximum "
"number of reminders."
msgstr "Pošlji dodatni opomnik toliko dni po zadnjem poslanem opomniku, dokler ni doseženo največje število opomnikov."

#: schema/Pledge/Pledge.entityType.php
msgid "Pledge Status ID"
msgstr "ID stanja zaveze"

#: schema/Pledge/Pledge.entityType.php
msgid ""
"Implicit foreign key to civicrm_option_values in the pledge_status option "
"group."
msgstr "Implicitni tuji ključ do civicrm_option_values v skupini možnosti pledge_status."

#: schema/Pledge/Pledge.entityType.php
msgid "The campaign for which this pledge has been initiated."
msgstr "Kampanja, za katero je bila dana ta zaveza."

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Pledge Block"
msgstr "Blok za zaveze"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Pledge Blocks"
msgstr "Bloki za zaveze"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Table containing Pledge blocks"
msgstr "Tabela z bloki za zaveze"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Pledge Block ID"
msgstr "ID bloka za zaveze"

#: schema/Pledge/PledgeBlock.entityType.php
msgid ""
"physical tablename for entity being joined to pledge, e.g. civicrm_contact"
msgstr "fizično ime tabele entitete, ki se povezuje z zavezo, npr. civicrm_contact"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Delimited list of supported frequency units"
msgstr "Seznam podprtih časovnih enot pogostosti, ločenih z ločili"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Expose Frequency Interval?"
msgstr "Prikaži interval pogostosti?"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Is frequency interval exposed on the contribution form."
msgstr "Ali je interval pogostosti prikazan na obrazcu za prispevke."

#: schema/Pledge/PledgeBlock.entityType.php
msgid "If true - recurring start date is shown."
msgstr "Če je omogočeno, je prikazan datum začetka ponavljajočih se plačil."

#: schema/Pledge/PledgeBlock.entityType.php
msgid "Allow Edits to Recurring Donation Start Date?"
msgstr "Dovoli spreminjanje datuma začetka ponavljajoče se donacije?"

#: schema/Pledge/PledgeBlock.entityType.php
msgid "If true - recurring start date is editable."
msgstr "Če je omogočeno, je mogoče urejati datum začetka ponavljajočih se plačil."

#: schema/Pledge/PledgePayment.entityType.php
msgid "Pledge Payments"
msgstr "Plačila zaveze"

#: schema/Pledge/PledgePayment.entityType.php
msgid "FK to Pledge table"
msgstr "Tuji ključ do tabele zavez"

#: schema/Pledge/PledgePayment.entityType.php
msgid ""
"Pledged amount for this payment (the actual contribution amount might be "
"different)."
msgstr "Zavezani znesek za to plačilo (dejanski znesek prispevka je lahko drugačen)."

#: schema/Pledge/PledgePayment.entityType.php
msgid "Actual Amount"
msgstr "Dejanski znesek"

#: schema/Pledge/PledgePayment.entityType.php
msgid "Actual amount that is paid as the Pledged installment amount."
msgstr "Dejanski znesek, plačan kot obrok zaveze."

#: schema/Pledge/PledgePayment.entityType.php
msgid "The date the pledge payment is supposed to happen."
msgstr "Predvideni datum plačila zaveze."

#: schema/Pledge/PledgePayment.entityType.php
#: templates/CRM/Pledge/Page/Payment.tpl
msgid "Last Reminder"
msgstr "Zadnji opomnik"

#: schema/Pledge/PledgePayment.entityType.php
msgid "The date that the most recent payment reminder was sent."
msgstr "Datum pošiljanja zadnjega opomnika za plačilo."

#: schema/Pledge/PledgePayment.entityType.php
#: templates/CRM/Pledge/Page/Payment.tpl
msgid "Reminders Sent"
msgstr "Opomniki poslani"

#: schema/Pledge/PledgePayment.entityType.php
msgid "The number of payment reminders sent."
msgstr "Število poslanih opomnikov za plačilo."

#: templates/CRM/Pledge/Form/Pledge.hlp
msgid "Sets the default financial type for payments against this pledge."
msgstr "Določi privzeto finančno vrsto za plačila te zaveze."

#: templates/CRM/Pledge/Form/Pledge.hlp
msgid ""
"Select an Online Contribution page that the user can access to make self-"
"service pledge payments. (Only Online Contribution pages configured to "
"include the Pledge option are listed.)"
msgstr "Izberite stran za spletne prispevke, na kateri lahko uporabnik samostojno plačuje zavezo. (Navedene so samo strani za spletne prispevke, na katerih je omogočena možnost zavez.)"

#: templates/CRM/Pledge/Form/Pledge.tpl
msgid ""
"You will not be able to send an acknowledgment for this pledge because there"
" is no email address recorded for this contact. If you want a acknowledgment"
" to be sent when this pledge is recorded, click Cancel and then click Edit "
"from the Summary tab to add an email address before recording the pledge."
msgstr "Potrdila za to zavezo ni mogoče poslati, ker za ta stik ni zabeleženega e-poštnega naslova. Če želite, da se ob vnosu zaveze pošlje potrdilo, kliknite Prekliči, nato pa na zavihku Povzetek kliknite Uredi in dodajte e-poštni naslov, preden zabeležite zavezo."

#: templates/CRM/Pledge/Form/Pledge.tpl
msgid ""
"WARNING: Deleting this pledge will also delete any related pledge payments."
msgstr "OPOZORILO: Brisanje te zaveze bo tudi izbrisalo vsa povezana plačila."

#: templates/CRM/Pledge/Form/Pledge.tpl
msgid ""
"Consider cancelling the pledge instead if you want to maintain an audit "
"trail and avoid losing payment data. To set the pledge status to Cancelled "
"and cancel any not-yet-paid pledge payments, first click Cancel on this "
"form. Then click the more &gt; link from the pledge listing, and select the "
"Cancel action."
msgstr "Če želite ohraniti revizijsko sled in se izogniti izgubi podatkov o plačilih, razmislite o preklicu zaveze. Če želite stanje zaveze nastaviti na Preklicano in preklicati vsa še neizvedena plačila zaveze, najprej kliknite Prekliči na tem obrazcu. Nato na seznamu zavez kliknite povezavo več &gt; in izberite dejanje Prekliči."

#: templates/CRM/Pledge/Form/Pledge.tpl
#: templates/CRM/Pledge/Form/PledgeView.tpl
msgid ""
" Pledge total has changed due to payment adjustments. Original pledge amount"
" was %1."
msgstr " Skupni znesek zaveze se je spremenil zaradi prilagoditev plačil. Prvotni znesek zaveze je bil %1."

#: templates/CRM/Pledge/Form/Pledge.tpl
#: templates/CRM/Pledge/Form/PledgeView.tpl
msgid "installments of"
msgstr "obrokih po"

#: templates/CRM/Pledge/Form/Pledge.tpl
msgid "day of the period"
msgstr "dan obdobja"

#: templates/CRM/Pledge/Form/Pledge.tpl
msgid "Automatically email an acknowledgment of this pledge to %1?"
msgstr "Samodejno pošlji potrdilo o tej zavezi po e-pošti na %1?"

#: templates/CRM/Pledge/Form/Pledge.tpl
msgid ""
"Pledges are \"Pending\" until the first payment is received. Once a payment "
