#: setup/plugins/blocks/admin.tpl.php
msgid "Administrator Account"
msgstr "Skrbniški račun"

#: setup/plugins/blocks/admin.tpl.php
msgid "Administrative User:"
msgstr "Skrbniško uporabniško ime:"

#: setup/plugins/blocks/admin.tpl.php
