#: ext/standaloneusers/ang/crmChangePassword.js
#: ext/standaloneusers/ang/crmResetPassword.js
msgid "Could not perform check; service error."
msgstr "Preverjanja ni bilo mogoče izvesti; servisna napaka."

#: ext/standaloneusers/ang/crmChangePassword.js
msgid "The given password cannot be considered secure."
msgstr "Podanega gesla ni mogoče šteti za varnega."

#: ext/standaloneusers/ang/crmChangePassword.js
msgid "Password NOT changed"
msgstr "Geslo NI spremenjeno"

#: ext/standaloneusers/ang/crmChangePassword.js
#: ext/standaloneusers/ang/crmResetPassword.js
msgid "Changing..."
msgstr "Spreminjanje ..."

#: ext/standaloneusers/ang/crmChangePassword.js
