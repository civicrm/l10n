msgstr "Vaše geslo je bilo uspešno spremenjeno."

#: ext/standaloneusers/ang/crmChangePassword.js
msgid "Password updated"
msgstr "Geslo posodobljeno"

#: ext/standaloneusers/ang/crmChangePassword.js
