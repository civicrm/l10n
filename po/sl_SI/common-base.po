msgstr "Izberite že obstoječo predlogo ali pa naložite dokument za združitev pošte."

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.hlp
msgid "Supported file formats: docx, odt"
msgstr "Podprti formati datotek: docx, odt"

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.hlp
msgid ""
"Select a page format from the list or configure your own format in the "
"settings below."
msgstr "Izberite obliko strani s seznama ali nastavite lastno obliko v spodnjih nastavitvah."

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.hlp
msgid ""
"Go to <strong><a href=\"%1\">Administer CiviCRM &raquo; Communications "
"&raquo; Print Page (PDF) Formats</a></strong> to add or edit formats or set "
"the default format."
msgstr "Pojdi na<strong><a href=\"%1\">Dajanje zdravila CiviCRM&raquo;Komunikacije&raquo;Natisni stran (PDF) Oblike</a></strong>dodajanje ali urejanje formatov ali nastavitev privzete oblike."

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.hlp
msgid ""
"Select a page format to use for the PDF file. Page formats define the paper "
"size and margins."
msgstr "Izberite obliko strani za datoteko PDF. Oblike strani določajo velikost papirja in robove."

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.tpl
msgid "Page Format:"
msgstr "Oblika strani:"

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.tpl
msgid "Width x Height"
msgstr "Širina x Višina"

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.tpl
msgid "Preview Document"
msgstr "Ogledni dokument"

#: templates/CRM/Contact/Form/Task/PDFLetterCommon.tpl
