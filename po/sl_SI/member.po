msgstr "Potrditev obnove članstva in račun sta bila poslana na %1."

#: CRM/Member/Form/MembershipRenewal.php
msgid ""
"Membership Renewal using a credit card requires a Membership fee. Since "
"there is no fee associated with the selected membership type, you can use "
"the normal renewal mode."
msgstr "Obnova članstva s kreditno kartico zahteva članarino. Ker za izbrano vrsto članstva ni določene članarine, lahko uporabite običajni način obnove članstva."

#: CRM/Member/Form/MembershipRenewal.php
msgid "Includes %1 amount of %2"
msgstr "Vključuje znesek %1 od %2"

#: CRM/Member/Form/MembershipRenewal.php
msgid "Renewal Membership Organization and Type"
msgstr "Organizacija in vrsta obnovitve članstva"

#: CRM/Member/Form/MembershipRenewal.php
msgid "Renewal Date"
msgstr "Datum obnovitve"

#: CRM/Member/Form/MembershipRenewal.php
msgid "Extend Membership by"
msgstr "Podaljšaj članstvo za"

#: CRM/Member/Form/MembershipRenewal.php
msgid "Please enter a whole number for how many periods to renew."
msgstr "Vnesite celo število za število obdobij obnove."

#: CRM/Member/Form/MembershipRenewal.php
