msgid "A membership confirmation and receipt has been sent to %1."
msgstr "Potrditev članstva in račun sta bila poslana na %1."

#: CRM/Member/Form/Membership.php
msgid ""
"Associated recurring contribution cannot be updated on membership type "
"change."
msgstr "Povezanega ponavljajočega prispevka ni mogoče posodobiti ob spremembi vrste članstva."

#: CRM/Member/Form/Membership.php
msgid "Associated contribution is updated on membership type change."
msgstr "Povezani prispevek je bil posodobljen ob spremembi vrste članstva."

#: CRM/Member/Form/Membership.php
msgid "Membership for %1 has been updated."
msgstr "Članstvo za %1 je bilo posodobljeno."

#: CRM/Member/Form/Membership.php
msgid "The Membership Expiration Date is %1."
msgstr "Datum poteka članstva je %1."

#: CRM/Member/Form/Membership.php
msgid "%1 membership for %2 has been added."
msgstr "%1 članstvo za %2 je bilo dodano."

#: CRM/Member/Form/Membership.php
msgid "The new Membership Expiration Date is %1."
msgstr "Novi datum poteka članstva je %1."

#: CRM/Member/Form/Membership.php
msgid ""
"The financial types associated with the old and new membership types are "
"different. You may want to edit the contribution associated with this "
"membership to adjust its financial type."
msgstr "Finančne vrste, povezane s staro in novo vrsto članstva, so različne. Morda boste želeli urediti prispevek, povezan s tem članstvom, da prilagodite njegovo finančno vrsto."

#: CRM/Member/Form/Membership.php
msgid ""
"The cost of the old and new membership types are different. You may want to "
"edit the contribution associated with this membership to adjust its amount."
msgstr "Stroški stare in nove vrste članstva so različni. Morda boste želeli urediti prispevek, povezan s tem članstvom, da prilagodite njegov znesek."

