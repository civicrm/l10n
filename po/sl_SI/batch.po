#: CRM/Batch/BAO/Batch.php
msgid "Batch %1"
msgstr "Paket %1"

#: CRM/Batch/BAO/Batch.php
msgid "Transactions"
msgstr "Transakcije"

#: CRM/Batch/BAO/Batch.php
msgid "View/Add Transactions to Batch"
msgstr "Prikaži/dodaj transakcije v paket"

#: CRM/Batch/BAO/Batch.php
msgid "Edit Batch"
msgstr "Uredi paket"

#: CRM/Batch/BAO/Batch.php
msgid "Re-open Batch"
msgstr "Znova odpri paket"

#: CRM/Batch/BAO/Batch.php
msgid "Delete Batch"
msgstr "Izbriši paket"

#: CRM/Batch/BAO/Batch.php
msgid "Download"
msgstr "Prenesi"

#: CRM/Batch/BAO/Batch.php
msgid "Download Batch"
msgstr "Prenesi paket"

#: CRM/Batch/BAO/Batch.php
msgid "Enter records"
msgstr "Vnesi zapise"

#: CRM/Batch/BAO/Batch.php
msgid "Batch Data Entry"
msgstr "Paketni vnos podatkov"

#: CRM/Batch/BAO/Batch.php
msgid "Expected Total"
msgstr "Pričakovani skupni znesek"

#: CRM/Batch/BAO/Batch.php
msgid "No batches were selected."
msgstr "Izbran ni noben paket."

#: CRM/Batch/BAO/Batch.php
msgid "No export format selected."
msgstr "Izbrana ni nobena oblika izvoza."

#: CRM/Batch/BAO/EntityBatch.php
msgid ""
"You cannot add items of two different currencies to a single contribution "
"batch. Batch id %1 currency: %2. Entity id %3 currency: %4."
msgstr "V en paket prispevkov ni mogoče dodati postavk v dveh različnih valutah. Valuta paketa z ID-jem %1: %2. Valuta entitete z ID-jem %3: %4."

#: CRM/Batch/BAO/EntityBatch.php
msgid ""
"This batch is configured to include only transactions using %1 payment "
"method. If you want to include other transactions, please edit the batch "
"first and modify the Payment Method."
msgstr "Ta paket je nastavljen tako, da vključuje samo transakcije z načinom plačila %1. Če želite vključiti tudi druge transakcije, najprej uredite paket in spremenite način plačila."

#: CRM/Batch/Form/Batch.php
msgid "Batch Deleted"
msgstr "Paket je izbrisan"

#: CRM/Batch/Form/Entry.php
msgid "Profile for bulk data entry is missing."
msgstr "Manjka profil za množični vnos podatkov."

#: CRM/Batch/Form/Entry.php
msgid "Batch Data Entry for Contributions"
msgstr "Paketni vnos prispevkov"

#: CRM/Batch/Form/Entry.php
msgid "Batch Data Entry for Memberships"
msgstr "Paketni vnos članstev"

#: CRM/Batch/Form/Entry.php
msgid "Batch Data Entry for Pledge Payments"
msgstr "Paketni vnos plačil zavez"

#: CRM/Batch/Form/Entry.php
msgid "Ignore Mismatch & Process the Batch?"
msgstr "Prezri neskladje in obdelaj paket?"

#: CRM/Batch/Form/Entry.php
msgid "Validate & Process the Batch"
msgstr "Preveri in obdelaj paket"

#: CRM/Batch/Form/Entry.php
msgid "Save & Continue Later"
msgstr "Shrani in nadaljuj pozneje"

#: CRM/Batch/Form/Entry.php
msgid ""
"Batch size is too large. Increase value of php.ini setting "
"\"max_input_vars\" (current val = %1)"
msgstr "Paket je prevelik. Povečajte vrednost nastavitve \"max_input_vars\" v datoteki php.ini (trenutna vrednost = %1)"

#: CRM/Batch/Form/Entry.php
msgid "Transaction ID must be unique within the database"
msgstr "ID transakcije mora biti enoličen v zbirki podatkov"

#: CRM/Batch/Form/Entry.php
msgid "Soft credit amount should not be greater than the total amount"
msgstr "Znesek posrednega prispevka ne sme biti večji od skupnega zneska"

#: CRM/Batch/Form/Entry.php
msgid "Membership type is a required field."
msgstr "Vrsta članstva je obvezno polje."

#: CRM/Batch/Form/Entry.php
msgid "You can not record two payments for the same pledge in a single batch."
msgstr "V istem paketu ni mogoče zabeležiti dveh plačil za isto zavezo."

#: CRM/Batch/Form/Entry.php templates/CRM/Batch/Form/Entry.tpl
msgid ""
"Total for amounts entered below does not match the expected batch total."
msgstr "Skupni znesek spodaj vnesenih postavk se ne ujema s pričakovanim skupnim zneskom paketa."

#: CRM/Batch/Form/Entry.php
msgid "Batch Processed."
msgstr "Paket je obdelan."

#: CRM/Batch/Form/Entry.php
msgid "Batch entry"
msgstr "Vnos paketa"

#: CRM/Batch/Form/Search.php
msgid "Find"
msgstr "Poišči"

#: CRM/Batch/Page/Batch.php
msgid "Batch Processing"
msgstr "Obdelava paketov"

#: templates/CRM/Batch/Form/Batch.tpl
msgid "Delete Data Entry Batch"
msgstr "Izbriši paket za vnos podatkov"

#: templates/CRM/Batch/Form/Batch.tpl
msgid "Edit Data Entry Batch"
msgstr "Uredi paket za vnos podatkov"

#: templates/CRM/Batch/Form/Batch.tpl templates/CRM/Batch/Form/Search.tpl
msgid "New Data Entry Batch"
msgstr "Nov paket za vnos podatkov"

#: templates/CRM/Batch/Form/Batch.tpl
msgid ""
"WARNING: Deleting this batch will result in the loss of all data entered for"
" the batch."
msgstr "OPOZORILO: Če izbrišete ta paket, bodo izgubljeni vsi podatki, vneseni vanj."

#: templates/CRM/Batch/Form/Entry.tpl
msgid ""
"Click Validate & Process below when you've entered all items for the batch. "
"You can also Save & Continue Later at any time."
msgstr "Ko vnesete vse postavke paketa, spodaj kliknite »Preveri in obdelaj paket«. Kadar koli lahko izberete tudi »Shrani in nadaljuj pozneje«."

#: templates/CRM/Batch/Form/Entry.tpl
msgid ""
"Add, remove or change the order of columns by editing the corresponding <a "
"href=\"%1\" target=\"_blank\">Bulk Entry profile</a>."
msgstr "Stolpce lahko dodate, odstranite ali spremenite njihov vrstni red, tako da uredite ustrezni <a href=\"%1\" target=\"_blank\">profil za množični vnos</a>."

#: templates/CRM/Batch/Form/Entry.tpl
msgid ""
"Custom fields and a Personal Campaign Page field can be added if needed."
msgstr "Po potrebi lahko dodate polja po meri in polje osebne strani kampanje."

#: templates/CRM/Batch/Form/Entry.tpl
msgid "Total amount expected"
msgstr "Pričakovani skupni znesek"

#: templates/CRM/Batch/Form/Entry.tpl
msgid "Total amount entered"
msgstr "Vneseni skupni znesek"

#: templates/CRM/Batch/Form/Entry.tpl
msgid "Open Pledges (Due Date - Amount)"
msgstr "Odprte zaveze (datum zapadlosti – znesek)"

#: templates/CRM/Batch/Form/Entry.tpl
msgid "Attached"
msgstr "Povezano"

#: templates/CRM/Batch/Form/Search.tpl
msgid "Data Entry Batches"
msgstr "Paketi za vnos podatkov"

#: templates/CRM/Batch/Form/Search.tpl
msgid "No matching Data Entry Batches found for your search criteria."
msgstr "Za vaša merila iskanja ni bilo mogoče najti nobenega ustreznega paketa za vnos podatkov."

#: templates/CRM/Batch/Form/Search.tpl
msgid "You do not have any Open Data Entry Batches."
msgstr "Nimate nobenega odprtega paketa za vnos podatkov."

#: templates/CRM/Batch/Form/Search.tpl
msgid "No Data Entry Batches have been created for this site."
msgstr "Za to spletno mesto ni bil ustvarjen noben paket za vnos podatkov."
