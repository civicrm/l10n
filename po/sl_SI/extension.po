#: CRM/Extension/Browser.php
msgid ""
"It is not possible to contact the CiviCRM extensions directory. You may be "
"missing out on the latest updates to extensions. Check that you can view the"
" <a %1>extension feed</a>. If that works check that your webserver can make "
"external HTTP requests."
msgstr "Povezave z imenikom razširitev CiviCRM ni mogoče vzpostaviti, zato morda ne boste prejeli najnovejših posodobitev razširitev. Preverite, ali si lahko ogledate <a %1>vir razširitev</a>. Če vir deluje, preverite, ali lahko vaš spletni strežnik pošilja zunanje zahteve HTTP."

#: CRM/Extension/Container/Basic.php CRM/Extension/Container/Default.php
msgid "Invalid Base Directory"
msgstr "Neveljaven osnovni imenik"

#: CRM/Extension/Container/Basic.php
msgid "An extension container has been defined with a blank directory."
msgstr "Vsebnik razširitev je določen s praznim imenikom."

#: CRM/Extension/Container/Basic.php CRM/Extension/Container/Default.php
msgid "Invalid Base URL"
msgstr "Neveljaven osnovni URL"

#: CRM/Extension/Container/Basic.php
msgid "An extension container has been defined with a blank URL."
msgstr "Vsebnik razširitev je določen s praznim URL-jem."

#: CRM/Extension/Container/Basic.php
msgid ""
"Failed to determine URL for extension (%1). Please update <a "
"href=\"%2\">Resource URLs</a>."
msgstr "URL-ja za razširitev (%1) ni bilo mogoče določiti. Posodobite <a href=\"%2\">URL-je virov</a>."

#: CRM/Extension/Container/Basic.php CRM/Extension/Mapper.php
msgid "Parse error in extension %1: %2"
msgstr "Napaka pri razčlenjevanju razširitve %1: %2"

#: CRM/Extension/Container/Default.php
msgid ""
"The extensions directory is not properly set. Please go to the <a "
"href=\"%1\">path setting page</a> and correct it.<br/>"
msgstr "Imenik razširitev ni pravilno nastavljen. Odprite <a href=\"%1\">stran za nastavitev poti</a> in popravite nastavitev.<br/>"

#: CRM/Extension/Container/Default.php
msgid ""
"The extensions URL is not properly set. Please go to the <a href=\"%1\">URL "
"setting page</a> and correct it.<br/>"
msgstr "URL razširitev ni pravilno nastavljen. Odprite <a href=\"%1\">stran za nastavitev URL-ja</a> in popravite nastavitev.<br/>"

#: CRM/Extension/Downloader.php
msgid "Directory Unwritable"
msgstr "V imenik ni mogoče pisati"

#: CRM/Extension/Downloader.php
msgid ""
"Your extensions directory is not set or is not writable. Click <a "
"href='%1'>here</a> to set the extensions directory."
msgstr "Imenik razširitev ni nastavljen ali pa vanj ni mogoče pisati. Za nastavitev imenika razširitev kliknite <a href='%1'>tukaj</a>."

#: CRM/Extension/Downloader.php
msgid "ZIP Support Required"
msgstr "Zahtevana je podpora za ZIP"

#: CRM/Extension/Downloader.php
msgid ""
"You will not be able to install extensions at this time because your "
"installation of PHP does not support ZIP archives. Please ask your system "
"administrator to install the standard PHP-ZIP extension."
msgstr "Razširitev trenutno ne boste mogli namestiti, ker vaša namestitev PHP ne podpira arhivov ZIP. Skrbnika sistema prosite, naj namesti standardno razširitev PHP-ZIP."

#: CRM/Extension/Downloader.php
msgid "Cannot install this extension - downloadUrl is not set!"
msgstr "Te razširitve ni mogoče namestiti – vrednost downloadUrl ni nastavljena!"

#: CRM/Extension/Downloader.php
msgid "Unable to extract the extension: bad directory structure"
msgstr "Razširitve ni mogoče razpakirati: neustrezna struktura imenikov"

#: CRM/Extension/Downloader.php
msgid "Unable to extract the extension: %1 cannot be cleared"
msgstr "Razširitve ni mogoče razpakirati: mesta %1 ni mogoče izprazniti"

#: CRM/Extension/Downloader.php
msgid "Installation Error"
msgstr "Napaka pri namestitvi"

#: CRM/Extension/Downloader.php
msgid "Unable to extract the extension to %1."
msgstr "Razširitve ni mogoče razpakirati v %1."

#: CRM/Extension/Downloader.php
msgid "Unable to extract the extension"
msgstr "Razširitve ni mogoče razpakirati"

#: CRM/Extension/Downloader.php
msgid "Failed reading data from %1 during installation"
msgstr "Med namestitvijo ni bilo mogoče prebrati podatkov iz %1"

#: CRM/Extension/Downloader.php
msgid ""
"Cannot install - there are differences between extdir XML file and archive "
"XML file!"
msgstr "Namestitev ni mogoča – datoteka XML imenika razširitev se razlikuje od datoteke XML v arhivu!"

#: CRM/Extension/Manager/Payment.php
msgid "This payment processor type is already installed."
msgstr "Ta vrsta ponudnika plačilnih storitev je že nameščena."

#: CRM/Extension/Manager/Payment.php
msgid "This payment processor type already exists."
msgstr "Ta vrsta ponudnika plačilnih storitev že obstaja."

#: CRM/Extension/Manager/Payment.php
msgid "Billing mode in info file has wrong value."
msgstr "Način obračunavanja v informacijski datoteki ima napačno vrednost."

#: CRM/Extension/Manager/Payment.php
msgid "This payment processor type is not registered."
msgstr "Ta vrsta ponudnika plačilnih storitev ni registrirana."

#: CRM/Extension/Manager/Payment.php
msgid "Failed to load file (%3) for payment processor (%1) while running \"%2\""
msgstr "Med izvajanjem »%2« ni bilo mogoče naložiti datoteke (%3) za ponudnika plačilnih storitev (%1)"

#: CRM/Extension/Manager/Payment.php
msgid ""
"Failed to determine file path for payment processor (%1) while running "
"\"%2\""
msgstr "Med izvajanjem »%2« ni bilo mogoče določiti poti do datoteke ponudnika plačilnih storitev (%1)"

#: CRM/Extension/Manager/Payment.php
msgid "Unrecognized payment hook (%1) in %2::%3"
msgstr "Neznan programski priključek za plačilo (%1) v %2::%3"

#: CRM/Extension/Manager/Report.php
msgid "This report is already registered."
msgstr "To poročilo je že registrirano."

#: CRM/Extension/Manager/Report.php
msgid ""
"Component for which you are trying to install the extension (%1) is "
"currently disabled."
msgstr "Komponenta, za katero želite namestiti razširitev (%1), je trenutno onemogočena."

#: CRM/Extension/Manager/Search.php
msgid "This custom search is already registered."
msgstr "To iskanje po meri je že registrirano."

#: CRM/Extension/Manager.php
msgid ""
"A copy of the extension (%1) is in a system folder (%2). The system copy "
"will be preserved, but the new copy will be used."
msgstr "Kopija razširitve (%1) je v sistemski mapi (%2). Sistemska kopija bo ohranjena, uporabljena pa bo nova kopija."

#: CRM/Extension/Manager.php
msgid "Missing Requirement: %1"
msgstr "Manjkajoča zahteva: %1"

#: CRM/Extension/Manager.php
msgid ""
"You will not be able to install/upgrade %1 until you have installed the %2 "
"extension."
msgstr "Razširitve %1 ne boste mogli namestiti ali nadgraditi, dokler ne namestite razširitve %2."

#: CRM/Extension/Mapper.php
msgid "An enabled extension is missing from the extensions directory"
msgstr "Omogočena razširitev manjka v imeniku razširitev"

#: CRM/Extension/Mapper.php
msgid "Version %1 is installed. <a %2>Upgrade to version %3</a>."
msgstr "Nameščena je različica %1. <a %2>Nadgradite na različico %3</a>."

#: CRM/Extension/QueueDownloader.php
msgid "Download and Install (<em><small>ID: %1</small></em>)"
msgstr "Prenesi in namesti (<em><small>ID: %1</small></em>)"

#: CRM/Extension/QueueDownloader.php
msgid "Fetch \"%1\" from \"%2\""
msgstr "Pridobi »%1« iz »%2«"

#: CRM/Extension/QueueDownloader.php
msgid "Verify requirements"
msgstr "Preveri zahteve"

#: CRM/Extension/QueueDownloader.php
msgid "Swap folders"
msgstr "Zamenjaj mapi"

#: CRM/Extension/QueueDownloader.php
msgid "Rebuild system"
msgstr "Znova zgradi sistem"

#: CRM/Extension/QueueDownloader.php
msgid "Upgrade database"
msgstr "Nadgradi zbirko podatkov"

#: CRM/Extension/QueueDownloader.php
msgid "Cleanup workspace"
msgstr "Počisti delovni prostor"

#: CRM/Extension/QueueDownloader.php
msgid "\"%1\""
msgstr "»%1«"

#: CRM/Extension/System.php
msgid "Disabled (Missing)"
msgstr "Onemogočeno (manjka)"

#: CRM/Extension/System.php
msgid "Enabled (Missing)"
msgstr "Omogočeno (manjka)"

#: CRM/Extension/System.php
msgid "Obsolete"
msgstr "Zastarelo"

#: CRM/Extension/Upgrader/RevisionsTrait.php
msgid "Upgrade %1 to revision %2 (main)"
msgstr "Nadgradi %1 na revizijo %2 (glavni korak)"

#: CRM/Extension/Upgrader/RevisionsTrait.php
msgid "Upgrade %1 to revision %2 (set revision)"
msgstr "Nadgradi %1 na revizijo %2 (nastavitev revizije)"

#: CRM/Extension/Upgrades.php
msgid "Update log tables"
msgstr "Posodobi tabele dnevnika"
