#: CRM/Queue/BAO/Queue.php
msgid "Delete failed tasks"
msgstr "Izbriši neuspešna opravila"

#: CRM/Queue/BAO/Queue.php
msgid "Abort the queue-runner"
msgstr "Prekini izvajalnik čakalne vrste"

#: CRM/Queue/BAO/Queue.php
msgid "Memory (Linear)"
msgstr "Pomnilnik (zaporedno)"

#: CRM/Queue/BAO/Queue.php
msgid "SQL (Linear)"
msgstr "SQL (zaporedno)"

#: CRM/Queue/BAO/Queue.php
msgid "SQL (Parallel)"
msgstr "SQL (vzporedno)"

#: CRM/Queue/Page/Monitor.php
msgid "Queue Monitor \"%1\""
msgstr "Nadzor čakalne vrste »%1«"

#: CRM/Queue/Page/Runner.php
msgid "Queue runner must be configured before execution."
msgstr "Izvajalnik čakalne vrste je treba nastaviti pred izvedbo."

#: CRM/Queue/Runner.php
msgid "Queue Runner"
msgstr "Izvajalnik čakalne vrste"

#: schema/Queue/Queue.entityType.php
msgid "Queues"
msgstr "Čakalne vrste"

#: schema/Queue/Queue.entityType.php
msgid "Stores a list of persistent queues"
msgstr "Hrani seznam trajnih čakalnih vrst"

#: schema/Queue/Queue.entityType.php
msgid "System Queue ID"
msgstr "ID sistemske čakalne vrste"

#: schema/Queue/Queue.entityType.php
msgid "Name of the queue"
msgstr "Ime čakalne vrste"

#: schema/Queue/Queue.entityType.php
msgid "Type of the queue"
msgstr "Vrsta čakalne vrste"

#: schema/Queue/Queue.entityType.php
msgid "Runner"
msgstr "Izvajalnik"

#: schema/Queue/Queue.entityType.php
msgid "Name of the task runner"
msgstr "Ime izvajalnika opravil"

#: schema/Queue/Queue.entityType.php
msgid "Maximum number of items in a batch."
msgstr "Največje število elementov v paketu."

#: schema/Queue/Queue.entityType.php
msgid "Lease Time"
msgstr "Čas rezervacije"

#: schema/Queue/Queue.entityType.php
msgid ""
"When claiming an item (or batch of items) for work, how long should the "
"item(s) be reserved. (Seconds)"
msgstr "Kako dolgo naj bodo elementi rezervirani, ko je za obdelavo prevzet element ali paket elementov? (V sekundah)"

#: schema/Queue/Queue.entityType.php
msgid "Retry Limit"
msgstr "Omejitev ponovnih poskusov"

#: schema/Queue/Queue.entityType.php
msgid "Number of permitted retries. Set to zero (0) to disable."
msgstr "Dovoljeno število ponovnih poskusov. Za onemogočenje nastavite na nič (0)."

#: schema/Queue/Queue.entityType.php
msgid "Retry Interval"
msgstr "Interval ponovnih poskusov"

#: schema/Queue/Queue.entityType.php
msgid "Number of seconds to wait before retrying a failed execution."
msgstr "Število sekund čakanja pred ponovnim poskusom neuspešne izvedbe."

#: schema/Queue/Queue.entityType.php
msgid "Execution status"
msgstr "Stanje izvajanja"

#: schema/Queue/Queue.entityType.php
msgid "Error Mode"
msgstr "Način obravnave napak"

#: schema/Queue/Queue.entityType.php
msgid "Fallback behavior for unhandled errors"
msgstr "Rezervni način delovanja ob neobravnavanih napakah"

#: schema/Queue/Queue.entityType.php
msgid "Is this a template configuration (for use by other/future queues)?"
msgstr "Ali je to predloga nastavitev za druge oziroma prihodnje čakalne vrste?"

#: schema/Queue/QueueItem.entityType.php
msgid "Queue Item"
msgstr "Element čakalne vrste"

#: schema/Queue/QueueItem.entityType.php
msgid "Queue Items"
msgstr "Elementi čakalne vrste"

#: schema/Queue/QueueItem.entityType.php
msgid "Stores a list of queue items"
msgstr "Hrani seznam elementov čakalne vrste"

#: schema/Queue/QueueItem.entityType.php
msgid "Queue Item ID"
msgstr "ID elementa čakalne vrste"

#: schema/Queue/QueueItem.entityType.php
msgid "Queue Name"
msgstr "Ime čakalne vrste"

#: schema/Queue/QueueItem.entityType.php
msgid "Name of the queue which includes this item"
msgstr "Ime čakalne vrste, ki vsebuje ta element"

#: schema/Queue/QueueItem.entityType.php
msgid "Submit Time"
msgstr "Čas oddaje"

#: schema/Queue/QueueItem.entityType.php
msgid "date on which this item was submitted to the queue"
msgstr "Datum, ko je bil ta element oddan v čakalno vrsto"

#: schema/Queue/QueueItem.entityType.php
msgid "Release Time"
msgstr "Čas sprostitve"

#: schema/Queue/QueueItem.entityType.php
msgid "date on which this job becomes available; null if ASAP"
msgstr "Datum, ko postane opravilo razpoložljivo; NULL, če naj bo na voljo čim prej"

#: schema/Queue/QueueItem.entityType.php
msgid "Run Count"
msgstr "Število poskusov izvajanja"

#: schema/Queue/QueueItem.entityType.php
msgid "Number of times execution has been attempted."
msgstr "Število poskusov izvajanja."

#: schema/Queue/QueueItem.entityType.php
msgid "Queue item data"
msgstr "Podatki elementa čakalne vrste"

#: schema/Queue/QueueItem.entityType.php
msgid "Serialized queue data"
msgstr "Serializirani podatki čakalne vrste"

#: templates/CRM/Queue/Page/Runner.tpl
msgid "Beginning first step"
msgstr "Začetek prvega koraka"

#: templates/CRM/Queue/Page/Runner.tpl
msgid "Retry"
msgstr "Poskusi znova"

#: templates/CRM/Queue/Page/Runner.tpl
msgid ""
"The Retry button will retry the step that failed. Sometimes temporary "
"factors may have affected the process on the first run and retrying may "
"work. Try this first."
msgstr "Z gumbom Poskusi znova boste ponovili neuspešni korak. Na prvi poskus so morda vplivale začasne okoliščine, zato je ponovni poskus lahko uspešen. Najprej poskusite to možnost."

#: templates/CRM/Queue/Page/Runner.tpl
msgid ""
"The Skip button will skip the step that failed and proceed with other steps."
" This could leave something broken, especially if the steps that follow "
"depended on the success of the crashed step. Use this as last resort."
msgstr "Z gumbom Preskoči boste izpustili neuspešni korak in nadaljevali z drugimi. Zaradi tega lahko del sistema ostane nedelujoč, zlasti če so naslednji koraki odvisni od uspeha neuspešnega koraka. To možnost uporabite le kot zadnjo možnost."

#: templates/CRM/Queue/Page/Runner.tpl
msgid ""
"If you are running the update in production, you may want to roll back to "
"your backup while you figure this out. You can use the CiviCRM chat site to "
"search/ask for help."
msgstr "Če posodobitev izvajate v produkcijskem okolju, lahko med iskanjem rešitve obnovite stanje iz varnostne kopije. Za iskanje pomoči ali vprašanja lahko uporabite spletno mesto za klepet CiviCRM."

#: templates/CRM/Queue/Page/Runner.tpl
msgid "Admin troubleshooting page"
msgstr "Skrbniška stran za odpravljanje težav"
