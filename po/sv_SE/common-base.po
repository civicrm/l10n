msgstr "Oövervakad sammanslagning av kontaktdubbletter"

#: templates/CRM/Contact/Page/DedupeFind.tpl
msgid "Batch Merge Selected Duplicates"
msgstr "Oövervakad sammanslagning av valda duplikat"

#: templates/CRM/Contact/Page/DedupeFind.tpl
msgid ""
