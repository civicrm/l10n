msgstr "Lägg till pptx till accepterade bifogade filtyper"

#: CRM/Upgrade/Incremental/php/FiveSeventyFive.php
msgid "Disable financial ACL extension if unused"
msgstr "Inaktivera finansiella ACL-förlängning om det inte används"

#: CRM/Upgrade/Incremental/php/FiveSeventyNine.php
msgid ""
"Some custom forms (%1) support authenticated email links. Please review the "
"<strong><a %2>CiviCRM 5.79 Form-Token Notice</a></strong>."
msgstr "Vissa anpassade formulär (%1) stöder autentiserade e-postlänkar. Se över <strong><a %2>CiviCRM 5.79 Form-Token Notice</a></strong>."

