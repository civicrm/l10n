#: CRM/Core/Permission.php
msgid "CiviCRM"
msgstr "CiviCRM"

#: CRM/Core/Permission.php
msgid "add contacts"
msgstr "lägg till kontakter"

#: CRM/Core/Permission.php
msgid "Create a new contact record in CiviCRM"
msgstr "Skapa en ny kontaktpost i CiviCRM"

#: CRM/Core/Permission.php
msgid "view all contacts"
msgstr "se alla kontakter"

#: CRM/Core/Permission.php
msgid ""
"View ANY CONTACT in the CiviCRM database, export contact info and perform "
"activities such as Send Email, Phone Call, etc."
msgstr "Visa EN VALFRI KONTAKT i CiviCRM-databasen, exportera kontaktinformation och utför åtgärder som Skicka e-post, Telefonsamtal etc."

#: CRM/Core/Permission.php
msgid "edit all contacts"
msgstr "ändra alla kontakter"

#: CRM/Core/Permission.php
msgid ""
"View, Edit and Delete ANY CONTACT in the CiviCRM database; Create and edit "
"relationships, tags and other info about the contacts"
msgstr "Visa, redigera och radera alla kontakter i CiviCRM-databasen; Skapa och redigera relationer, taggar och annan information om kontakterna"

#: CRM/Core/Permission.php
msgid "view my contact"
msgstr "Visa min kontakt"

#: CRM/Core/Permission.php
msgid "edit my contact"
msgstr "redigera min kontakt"

#: CRM/Core/Permission.php
msgid "delete contacts"
msgstr "radera kontakter"

#: CRM/Core/Permission.php
msgid "access deleted contacts"
msgstr "Tillgång till raderade kontakter"

#: CRM/Core/Permission.php
msgid "Access contacts in the trash"
msgstr "Access-kontakter i papperskorgen"

#: CRM/Core/Permission.php
msgid "import contacts"
msgstr "importera kontakter"

#: CRM/Core/Permission.php
msgid "Import contacts and activities"
msgstr "Importera kontakter och åtgärder"

#: CRM/Core/Permission.php
msgid "import SQL datasource"
msgstr "importera SQL-datakälla"

#: CRM/Core/Permission.php
msgid "When importing, consume data directly from a SQL datasource"
msgstr "Vid import, konsumera data direkt från en SQL-datakälla"

#: CRM/Core/Permission.php
msgid "edit groups"
msgstr "ändra grupper"

#: CRM/Core/Permission.php
msgid ""
"Create new groups, edit group settings (e.g. group name, visibility...), "
"delete groups"
msgstr "Skapa nya grupper, redigera inställningar för grupper (t.ex gruppnamn, synlighet, ...), radera grupper"

#: CRM/Core/Permission.php
msgid "administer CiviCRM"
msgstr "administrera CiviCRM"

#: CRM/Core/Permission.php
msgid ""
"Perform all tasks in the Administer CiviCRM control panel and Import "
"Contacts"
msgstr "Utför alla uppgifter i administratören CiviCRM kontrollpanelen och Importera kontakter"

#: CRM/Core/Permission.php
msgid "skip IDS check"
msgstr "hoppa över IDS check"

#: CRM/Core/Permission.php
msgid ""
"Warning: Give to trusted roles only; this permission has security "
"implications. IDS system is bypassed for users with this permission. "
"Prevents false errors for admin users."
msgstr "Varning: Ge till betrodda roller endast; detta tillstånd har säkerhetseffekter. IDS-systemet är förbipasserat för användare med detta tillstånd. Förhindrar falska fel för admin-användare."

#: CRM/Core/Permission.php
msgid "access uploaded files"
msgstr "kom åt uppladdade filer"

#: CRM/Core/Permission.php
msgid "View / download files including images and photos"
msgstr "Visa / ladda ner filer inklusive bilder och foton"

#: CRM/Core/Permission.php
msgid "profile listings and forms"
msgstr "profillistor och formulär"

#: CRM/Core/Permission.php
msgid ""
"Warning: Give to trusted roles only; this permission has privacy "
"implications. Add/edit data in online forms and access public searchable "
"directories."
msgstr "Varning: Ge endast till betrodda roller; denna behörighet har integritetskonsekvenser. Lägg till/redigera data i onlineformulär och få åtkomst till offentliga sökbara kataloger."

#: CRM/Core/Permission.php
msgid "profile listings"
msgstr "profillistor"

#: CRM/Core/Permission.php
msgid ""
"Warning: Give to trusted roles only; this permission has privacy "
"implications. Access public searchable directories."
msgstr "Varning: Ge till betrodda roller endast; detta tillstånd har sekretess konsekvenser. Access offentliga sökbara kataloger."

#: CRM/Core/Permission.php
msgid "profile create"
msgstr "profil skapa"

#: CRM/Core/Permission.php
msgid "Add data in a profile form."
msgstr "Lägg till data i ett profilformulär."

#: CRM/Core/Permission.php
msgid "profile edit"
msgstr "profil redigera"

#: CRM/Core/Permission.php
msgid "Edit data in a profile form."
msgstr "Redigera data i ett profilformulär."

#: CRM/Core/Permission.php
msgid "profile view"
msgstr "profil visa"

#: CRM/Core/Permission.php
msgid "View data in a profile."
msgstr "Visa data i en profil."

#: CRM/Core/Permission.php
msgid "access all custom data"
msgstr "kom åt anpassad data"

#: CRM/Core/Permission.php
msgid "View all custom fields regardless of ACL rules"
msgstr "Visa alla anpassade fält oavsett ACL-regler"

#: CRM/Core/Permission.php
msgid "view all activities"
msgstr "visa alla åtgärder"

#: CRM/Core/Permission.php
msgid "View all activities (for visible contacts)"
msgstr "Visa alla åtgärder (för synliga kontakter)"

#: CRM/Core/Permission.php
msgid "Delete activities"
msgstr "Radera åtgärder"

#: CRM/Core/Permission.php
msgid "edit inbound email basic information"
msgstr "redigera inkommande e-post grundläggande information"

#: CRM/Core/Permission.php
msgid ""
"Edit all inbound email activities (for visible contacts) basic information. "
"Content editing not allowed."
msgstr "Redigera alla inkommande e-postaktiviteter (för synliga kontakter) grundläggande information. Innehållsredigering är inte tillåten."

#: CRM/Core/Permission.php
msgid "edit inbound email basic information and content"
msgstr "redigera inkommande e-post grundläggande information och innehåll"

#: CRM/Core/Permission.php
msgid ""
"Edit all inbound email activities (for visible contacts) basic information "
"and content."
msgstr "Redigera alla inkommande e-postaktiviteter (för synliga kontakter) grundläggande information och innehåll."

#: CRM/Core/Permission.php
msgid "access CiviCRM backend and API"
msgstr "Access CiviCRM backend och API"

#: CRM/Core/Permission.php
msgid ""
"Master control for access to the main CiviCRM backend and API. Give to "
"trusted roles only."
msgstr "Masterkontroll för tillgång till huvud CiviCRM backend och API. Ge endast betrodda roller."

#: CRM/Core/Permission.php
msgid "access Contact Dashboard"
msgstr "ta fram Contact Dashboard"

#: CRM/Core/Permission.php
msgid "View Contact Dashboard (for themselves and visible contacts)"
msgstr "Visa kontaktpanel (för sig själv och synliga kontakter)"

#: CRM/Core/Permission.php
msgid "translate CiviCRM"
msgstr "översätta CiviCRM"

#: CRM/Core/Permission.php
msgid "Allow User to enable multilingual"
msgstr "Tillåt användaren att möjliggöra flerspråkig"

#: CRM/Core/Permission.php
msgid "manage tags"
msgstr "hantera etiketter"

#: CRM/Core/Permission.php
msgid "Create and rename tags"
msgstr "Skapa och byt namn på etiketter"

#: CRM/Core/Permission.php
msgid "administer reserved groups"
msgstr "administrera reserverade grupper"

#: CRM/Core/Permission.php
msgid "Edit and disable Reserved Groups (Needs Edit Groups)"
msgstr "Redigera och inaktivera reserverade grupper (Kräver Redigera grupper)"

#: CRM/Core/Permission.php
msgid "administer Tagsets"
msgstr "Administrera etikettmängder"

#: CRM/Core/Permission.php
msgid "administer reserved tags"
msgstr "Administrera reserverade etiketter"

#: CRM/Core/Permission.php
msgid "administer queues"
msgstr "administrera köer"

#: CRM/Core/Permission.php
msgid "Initialize, browse, and cancel background processing queues"
msgstr "Initialisera, bläddra och avbryta bakgrundsbearbetningsköer"

#: CRM/Core/Permission.php
msgid "administer dedupe rules"
msgstr "administrera regler för duplikateliminering"

#: CRM/Core/Permission.php
msgid "Create and edit rules, change the supervised and unsupervised rules"
msgstr "Skapa och ändra regler, ändra vad som är övervakade och oövervakade regler för kontakttypen"

#: CRM/Core/Permission.php
msgid "merge duplicate contacts"
msgstr "slå ihop duplicerade kontakter"

#: CRM/Core/Permission.php
msgid "Delete Contacts must also be granted in order for this to work."
msgstr "Ta bort kontakter måste också beviljas för att detta ska fungera."

#: CRM/Core/Permission.php
msgid "force merge duplicate contacts"
msgstr "kraft sammanfogar dubblettkontakter"

#: CRM/Core/Permission.php
msgid "view debug output"
msgstr "Visa Debug Output"

#: CRM/Core/Permission.php
msgid "View results of debug and backtrace"
msgstr "Visa resultat av debug och backtrace"

#: CRM/Core/Permission.php
msgid "view all notes"
msgstr "Visa alla anteckningar"

#: CRM/Core/Permission.php
msgid "View notes (for visible contacts) even if they're marked admin only"
msgstr "Visa anteckningar (för synliga kontakter) även om de är markerade admin"

#: CRM/Core/Permission.php
msgid "add contact notes"
msgstr "lägga till kontaktanteckningar"

#: CRM/Core/Permission.php
msgid "Create notes for contacts"
msgstr "Skapa anteckningar för kontakter"

#: CRM/Core/Permission.php
msgid "access AJAX API"
msgstr "Tillgång AJAX API"

#: CRM/Core/Permission.php
msgid "Allow API access even if Access CiviCRM is not granted"
msgstr "Tillåt API-åtkomst även om Access CiviCRM inte beviljas"

#: CRM/Core/Permission.php
msgid "access contact reference fields"
msgstr "Tillgång till kontaktreferensfält"

#: CRM/Core/Permission.php
msgid "Allow entering data into contact reference fields"
msgstr "Tillåt inmatning av data i kontaktreferensfält"

#: CRM/Core/Permission.php
msgid "create manual batch"
msgstr "skapa sats för manuell bearbetning"

#: CRM/Core/Permission.php
msgid ""
"Create an accounting batch (with Access to CiviContribute and View Own/All "
"Manual Batches)"
msgstr "Skapa en redovisningssats (med tillgång till CiviContribute och Visa egna / alla manuella bänkar)"

#: CRM/Core/Permission.php
msgid "edit own manual batches"
msgstr "redigera egna satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "Edit accounting batches created by user"
msgstr "Redigera redovisningssatser skapade av användaren"

#: CRM/Core/Permission.php
msgid "edit all manual batches"
msgstr "redigera alla satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "Edit all accounting batches"
msgstr "Redigera alla redovisningssatser"

#: CRM/Core/Permission.php
msgid "close own manual batches"
msgstr "nära egna manuella batcher"

#: CRM/Core/Permission.php
msgid ""
"Close accounting batches created by user (with Access to CiviContribute)"
msgstr "Stäng redovisningssatser som skapats av användaren (med tillgång till CiviContribute)"

#: CRM/Core/Permission.php
msgid "close all manual batches"
msgstr "Stäng alla manuella batcher"

#: CRM/Core/Permission.php
msgid "Close all accounting batches (with Access to CiviContribute)"
msgstr "Stäng alla redovisningssatser (med tillgång till CiviContribute)"

#: CRM/Core/Permission.php
msgid "reopen own manual batches"
msgstr "Åter öppna egna manuella batcher"

#: CRM/Core/Permission.php
msgid ""
"Reopen accounting batches created by user (with Access to CiviContribute)"
msgstr "Åter öppna redovisningssatser som skapats av användaren (med tillgång till CiviContribute)"

#: CRM/Core/Permission.php
msgid "reopen all manual batches"
msgstr "öppna alla manuella satser"

#: CRM/Core/Permission.php
msgid "Reopen all accounting batches (with Access to CiviContribute)"
msgstr "Öppna alla redovisningssatser (med tillgång till CiviContribute)"

#: CRM/Core/Permission.php
msgid "view own manual batches"
msgstr "visa egna staser för manuell bearbetnings"

#: CRM/Core/Permission.php
msgid ""
"View accounting batches created by user (with Access to CiviContribute)"
msgstr "Visa redovisningssatser som skapats av användaren (med tillgång till CiviContribute)"

#: CRM/Core/Permission.php
msgid "view all manual batches"
msgstr "visa alla satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "View all accounting batches (with Access to CiviContribute)"
msgstr "Visa alla redovisningssatser (med tillgång till CiviContribute)"

#: CRM/Core/Permission.php
msgid "delete own manual batches"
msgstr "radera egna satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "Delete accounting batches created by user"
msgstr "Ta bort redovisningssatser som skapats av användaren"

#: CRM/Core/Permission.php
msgid "delete all manual batches"
msgstr "radera alla satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "Delete all accounting batches"
msgstr "Ta bort alla redovisningssatser"

#: CRM/Core/Permission.php
msgid "export own manual batches"
msgstr "exportera egna satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "Export accounting batches created by user"
msgstr "Exportera redovisningssatser som skapats av användaren"

#: CRM/Core/Permission.php
msgid "export all manual batches"
msgstr "exportera alla satser för manuell bearbetning"

#: CRM/Core/Permission.php
msgid "Export all accounting batches"
msgstr "Exportera alla redovisningssatser"

#: CRM/Core/Permission.php
msgid "administer payment processors"
msgstr "administrera betalningstjänster"

#: CRM/Core/Permission.php
msgid "Add, Update, or Disable Payment Processors"
msgstr "Lägg till, ändra eller avaktivera betalningstjänster"

#: CRM/Core/Permission.php
msgid "render templates"
msgstr "render mallar"

#: CRM/Core/Permission.php
msgid ""
"Render open-ended template content. (Additional constraints may apply to "
"autoloaded records and specific notations.)"
msgstr "Rendera öppna mallinnehåll. (Ytterligare begränsningar kan gälla för autoladdade poster och specifika noteringar.)"

#: CRM/Core/Permission.php
msgid "edit message templates"
msgstr "redigera meddelandemallar"

#: CRM/Core/Permission.php
msgid "edit system workflow message templates"
msgstr "redigera systemets arbetsflödesmeddelandesabloner"

#: CRM/Core/Permission.php
msgid "edit user-driven message templates"
msgstr "redigera användardrivna meddelandemallar"

#: CRM/Core/Permission.php
msgid "view my invoices"
msgstr "visa mina fakturor"

#: CRM/Core/Permission.php
msgid "Allow users to view/ download their own invoices"
msgstr "Tillåt användare att visa/ladda ner sina egna fakturor"

#: CRM/Core/Permission.php
msgid "edit api keys"
msgstr "redigera API-nycklar"

#: CRM/Core/Permission.php
msgid "Edit API keys"
msgstr "Redigera API-nycklar"

#: CRM/Core/Permission.php
msgid "edit own api keys"
msgstr "redigera egna api-nycklar"

#: CRM/Core/Permission.php
msgid "Edit user's own API keys"
msgstr "Redigera användarens egna API-nycklar"

#: CRM/Core/Permission.php
msgid "send SMS"
msgstr "Skicka SMS"

#: CRM/Core/Permission.php
msgid "Send an SMS"
msgstr "Skicka ett SMS"

#: CRM/Core/Permission.php
msgid "administer CiviCRM System"
msgstr "administrera CiviCRM-systemet"

#: CRM/Core/Permission.php
msgid "Perform all system administration tasks in CiviCRM"
msgstr "Utför alla systemadministrationsuppgifter i CiviCRM"

#: CRM/Core/Permission.php
msgid "administer CiviCRM Data"
msgstr "administrera CiviCRM-data"

#: CRM/Core/Permission.php
msgid "Permit altering all restricted data options"
msgstr "Tillåt att ändra alla begränsade dataalternativ"

#: CRM/Core/Permission.php
msgid "all CiviCRM permissions and ACLs"
msgstr "alla CiviCRM behörigheter och ACL"

#: CRM/Core/Permission.php
msgid ""
"Administer and use CiviCRM bypassing any other permission or ACL checks and "
"enabling the creation of displays and forms that allow others to bypass "
"checks. This permission should be given out with care"
msgstr "Administrera och använda CiviCRM förbigå något annat tillstånd eller ACL-kontroller och möjliggöra skapandet av displayer och formulär som tillåter andra att kringgå kontroller. Detta tillstånd bör ges ut med omsorg."

#: CRM/Core/Permission.php
msgid "administer Multiple Organizations"
msgstr "administrera flera organisationer"

#: CRM/Core/Permission.php
msgid ""
"Administer multiple organizations. In practice this allows editing the group"
" organization link"
msgstr "Administrera flera organisationer. I praktiken tillåter detta att redigera grupporganisationslänken"
